      "importedAt": 0,
      "mimeType": "text/markdown",
      "name": "Getting Started.md",
      "path": "Assets/Tutorials/Getting Started.md",
      "pipeline": {
        "artifactHash": "63694dd577e7ac8e4336eb7b37a850d49402929501be064096095f6ab47c920e",
        "artifactSettings": "{}",
        "artifactSettingsHash": "63694dd577e7ac8e4336eb7b37a850d49402929501be064096095f6ab47c920e",
        "cacheHit": false,
        "cacheKey": "63694dd577e7ac8e4336eb7b37a850d49402929501be064096095f6ab47c920e",
