# Copy these values into the environment managed by PM2. Do not commit real secrets.
NODE_ENV=production
PORT=3000
TRUST_PROXY=1
SESSION_SECRET=replace-with-at-least-48-random-bytes

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=german_vocab
DB_USER=vocabuser
DB_PASSWORD=replace-with-a-unique-database-password
DB_POOL_SIZE=10

# Used only once if no administrator exists. Remove after the first secure startup.
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
