_set(0.0); set_position(-7.5, -4.0);\\n  for index in 0..6 { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (index + 1)), index == 0); }\\n  ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint 1/6 | WASD / arrows | R restart\\\"); return; }\\n  if finished { return; }\\n  elapsed += dt;\\n  let pose = transform();\\n  let mx = input_axis(\\\"MoveHorizontal\\\"); let my = input_axis(\\\"MoveVertical\\\");\\n  if mx != 0.0 && my != 0.0 { mx *= 0.7071067811865476; my *= 0.7071067811865476; }\\n  let x = pose.position_x + mx * 6.0 * dt;\\n  let y = pose.position_y + my * 6.0 * dt;\\n  if x < -8.0 { x = -8.0; } else if x > 8.0 { x = 8.0; }\\n  if y < -4.5 { y = -4.5; } else if y > 4.5 { y = 4.5; }\\n  set_position(x, y);\\n  \\n  \\n  let xs = [-6.0, -3.0, 0.0, 3.0, 6.0, 0.0]; let ys = [-2.0, 1.0, 3.0, 1.0, -2.0, -3.0];\\n  let dx = x - xs[checkpoint]; let dy = y - ys[checkpoint];\\n  if dx * dx + dy * dy < 0.64 {\\n    entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), false);\\n    checkpoint += 1; score_add(1.0);\\n    if checkpoint == 6 { finished = true; ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Course complete! | R to restart\\\"); }\\n    else { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), true); }\\n  }\\n  if !finished { ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint \\\" + (checkpoint + 1) + \\\"/6 | elapsed \\\" + elapsed.to_int() + \\\"s | R restart\\\"); }\\n}\",\n        \"sourceColumn\": 1,\n        \"sourceEnd\": 2064,\n        \"sourceStart\": 533,\n        \"syntaxScopeId\": \"scope:module\"\n      }\n    },\n    {\n      \"uuid\": \"92c5c78e-4850-4a50-aa03-838518dac364\",\n      \"type\": \"rhai.Literal\",\n      \"title\": \"Literal\",\n      \"category\": \"Language values\",\n      \"position\": {\n        \"x\": 2100,\n        \"y\": 1272\n      },\n      \"size\": {\n        \"width\": 25