        "lastValidSource": "{\n  \"format\": \"nova-graph\",\n  \"version\": 1,\n  \"apiVersion\": 2,\n  \"uuid\": \"0eb7631f-8b37-43e1-ab11-33d0f5a4af63\",\n  \"name\": \"CheckpointGame\",\n  \"variables\": [],\n  \"routines\": [],\n  \"customEvents\": [],\n  \"interfaces\": [],\n  \"libraries\": [],\n  \"debug\": {\n    \"breakpoints\": [],\n    \"watches\": [],\n    \"breakOnError\": true,\n    \"coverageEnabled\": true\n  },\n  \"migrations\": [],\n  \"language\": {\n    \"version\": 1,\n    \"source\": \"@export(type=\\\"int\\\", min=0, max=8, group=\\\"Runtime\\\") let checkpoint = 0;\\n@export(type=\\\"float\\\", min=0, max=10000, group=\\\"Runtime\\\") let elapsed = 0.0;\\n@export(type=\\\"bool\\\", group=\\\"Runtime\\\") let finished = false;\\nfn start() { \\n  checkpoint = 0; elapsed = 0.0; finished = false; score_set(0.0); set_position(-7.5, -4.0);\\n  for index in 0..6 { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (index + 1)), index == 0); }\\n  ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint 1/6 | WASD / arrows | R restart\\\"); }\\nfn update(dt) {\\n  if input_pressed(\\\"Restart\\\") { \\n  checkpoint = 0; elapsed = 0.0; finished = false; score_set(0.0); set_position(-7.5, -4.0);\\n  for index in 0..6 { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (index + 1)), index == 0); }\\n  ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint 1/6 | WASD / arrows | R restart\\\"); return; }\\n  if finished { return; }\\n  elapsed += dt;\\n  let pose = transform();\\n  let mx = input_axis(\\\"MoveHorizontal\\\"); let my = input_axis(\\\"MoveVertical\\\");\\n  if mx != 0.0 && my != 0.0 { mx *= 0.7071067811865476; my *= 0.7071067811865476; }\\n  let x = pose.position_x + mx * 6.0 * dt;\\n  let y = pose.position_y + my * 6.0 * dt;\\n  if x < -8.0 { x = -8.0; } else if x > 8.0 { x = 8.0; }\\n  if y < -4.5 { y = -4.5; } else if y > 4.5 { y = 4.5; }\\n  set_position(x, y);\\n  \\n  \\n  let xs = [-6.0, -3.0, 0.0, 3.0, 6.0, 0.0]; let ys = [-2.0, 1.0, 3.0, 1.0, -2.0, -3.0];\\n  let dx = x - xs[checkpoint]; let dy = y - ys[checkpoint];\\n  if dx * dx + dy * dy < 0.64 {\\n    entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), false);\\n    checkpoint += 1; score_add(1.0);\\n    if checkpoint == 6 { finished = true; ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Course complete! | R to restart\\\"); }\\n    else { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), true); }\\n  }\\n  if !finished { ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint \\\" + (checkpoint + 1) + \\\"/6 | elapsed \\\" + elapsed.to_int() + \\\"s | R restart\\\"); }\\n}\",\n    \"rootNodeUuid\": \"e960f2ee-c073-413d-a5b2-480696548ae9\"\n  },\n  \"nodes\": [\n    {\n      \"uuid\": \"003383f7-8684-4a41-a6b9-89f5d28e4302\",\n      \"type\": \"rhai.ExportMetadata\",\n      \"title\": \"Export Metadata · min\",\n      \"category\": \"Language values\",\n      \"position\": {\n        \"x\": 934,\n        \"y\": 932\n      },\n      \"size\": {\n        \"width\": 256,\n        \"height\": 110\n      },\n      \"collapsed\": false,\n      \"pins\": [\n        {\n          \"uuid\": \"6db9e129-4502-4a15-ad8a-7b245ec207b2\",\n          \"key\": \"result\",\n          \"name\": \"Value\",\n          \"direction\": \"output\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"ac3d5488-cf99-437f-a6de-91dfae4f40b3\",\n          \"key\": \"value\",\n          \"name\": \"value\",\n          \"direction\": \"input\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": true,\n          \"defaultValue\": null\n        }\n      ],\n      \"config\": {\n        \"astId\": \"scope:module/node:ExportMetadata:49ac15a