rse complete! | R to restart\\\"); }\\n    else { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), true); }\\n  }\\n  if !finished { ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint \\\" + (checkpoint + 1) + \\\"/6 | elapsed \\\" + elapsed.to_int() + \\\"s | R restart\\\"); }\\n}\",\n        \"sourceColumn\": 1,\n        \"sourceEnd\": 2064,\n        \"sourceStart\": 533,\n        \"syntaxScopeId\": \"scope:module\"\n      }\n    },\n    {\n      \"uuid\": \"ec4a40c3-39f8-4b9e-a3b1-b768ed0c9d15\",\n      \"type\": \"rhai.Identifier\",\n      \"title\": \"Identifier · transform\",\n      \"category\": \"Language values\",\n      \"position\": {\n        \"x\": 5850,\n        \"y\": 4934\n      },\n      \"size\": {\n        \"width\": 256,\n        \"height\": 108\n      },\n      \"collapsed\": false,\n      \"pins\": [\n        {\n          \"uuid\": \"49292156-89dc-4c86-a698-e7848dc4feab\",\n          \"key\": \"result\",\n          \"name\": \"Value\",\n          \"direction\": \"output\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        }\n      ],\n      \"config\": {\n        \"astId\": \"scope:module/function:update/1:1/node:Identifier:transform:1\",\n        \"bindingId\": \"\",\n        \"fieldSpans\": {\n          \"name\": [\n            0,\n            9\n          ]\n        },\n        \"fields\": {\n          \"name\": \"transform\"\n        },\n        \"originalFields\": {\n          \"name\": \"transform\"\n        },\n        \"ownedComments\": [],\n        \"slots\": [],\n        \"source\": \"transform\",\n        \"sourceColumn\": 14,\n        \"sourceEnd\": 967,\n        \"sourceStart\": 958,\n        \"syntaxScopeId\": \"scope:module/function:update/1:1\"\n      }\n    },\n    {\n      \"uuid\": \"ecc01a9d-ab10-4168-ae6e-319604e0625a\",\n      \"type\": \"rhai.Call\",\n      \"title\": \