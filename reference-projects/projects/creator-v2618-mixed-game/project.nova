\",\n          \"name\": \"Value\",\n          \"direction\": \"output\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"00d7086d-9749-486b-ae95-aafa87399e4e\",\n          \"key\": \"parameters_0\",\n          \"name\": \"parameters 0\",\n          \"direction\": \"input\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"2b2fe119-41aa-4aa6-ae1e-4a2d219bdb59\",\n          \"key\": \"body\",\n          \"name\": \"body\",\n          \"direction\": \"input\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": true,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"642cdb10-661b-4adc-a189-a5d94c46dea9\",\n          \"key\": \"parameters_1\",\n          \"name\": \"Add parameters\",\n          \"direction\": \"input\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        }\n      ],\n      \"config\": {\n        \"astId\": \"scope:module/node:FunctionDeclaration:update/1:1\",\n        \"bindingId\": \"scope:module/binding:function:update/1:1\",\n        \"fieldSpans\": {\n          \"name\": [\n            3,\n            9\n          ]\n        },\n        \"fields\": {\n          \"name\": \"update\",\n          \"private\": false\n        },\n        \"originalFields\": {\n          \"name\": \"update\",\n          \"private\": false\n        },\n        \"ownedComments\": [],\n        \"slots\": [\n          {\n            \"childId\": \"8a85a6d0-209b-47fb-ab95-de6d8c68be2a\",\n            \"end\": 12,\n            \"fallback\": \"\",\n            \"field\": \"parameters\",\n            \"index\": 0,\n            \"key\": \"parameters_0\",\n            \"start\": 10\n          },\n          {\n            \"childId\": \"aa7f33f5-4eef-4a77-a797-b948382b92b1\",\n            \"end\": 1531,\n            \"fallback\": \"\",\n            \"field\": \"body\",\n            \"index\": -1,\n            \"key\": \"body\",\n            \"start\": 14\n          },\n          {\n            \"childId\": \"\",\n            \"end\": -1,\n            \"fallback\": \"\",\n            \"field\": \"parameters\",\n            \"index\": 1,\n            \"key\": \"parameters_1\",\n            \"start\": -1\n          }\n        ],\n        \"source\": \"fn update(dt) {\\n  if input_pressed(\\\"Restart\\\") { \\n  checkpoint = 0; elapsed = 0.0; finished = false; score_set(0.0); set_position(-7.5, -4.0);\\n  for index in 0..6 { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (index + 1)), index == 0); }\\n  ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint 1/6 | WASD / arrows | R restart\\\"); return; }\\n  if finished { return; }\\n  elapsed += dt;\\n  let pose = transform();\\n  let mx = input_axis(\\\"MoveHorizontal\\\"); let my = input_axis(\\\"MoveVertical\\\");\\n  if mx != 0.0 && my != 0.0 { mx *= 0.7071067811865476; my *= 0.7071067811865476; }\\n  let x = pose.position_x + mx * 6.0 * dt;\\n  let y = pose.position_y + my * 6.0 * dt;\\n  if x < -8.0 { x = -8.0; } else if x > 8.0 { x = 8.0; }\\n  if y < -4.5 { y = -4.5; } else if y > 4.5 { y = 4.5; }\\n  set_position(x, y);\\n  \\n  \\n  let xs = [-6.0, -3.0, 0.0, 3.0, 6.0, 0.0]; let ys = [-2.0, 1.0, 3.0, 1.0, -2.0, -3.0];\\n  let dx = x - xs[checkpoint]; let dy = y - ys[checkpoint];\\n  if dx * dx + dy * dy < 0.64 {\\n    entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), false);\\n    checkpoint += 1; score_add(1.0);\\n    if checkpoint == 6 { finished = true; ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Course complete! | R to restart\\\"); }\\n    else { entity_set_enabled(find_entity_handl