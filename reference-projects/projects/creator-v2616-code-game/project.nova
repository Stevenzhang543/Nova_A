\\n  let xs = [-6.0, -3.0, 0.0, 3.0, 6.0, 0.0]; let ys = [-2.0, 1.0, 3.0, 1.0, -2.0, -3.0];\\n  let dx = x - xs[checkpoint]; let dy = y - ys[checkpoint];\\n  if dx * dx + dy * dy < 0.64 {\\n    entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), false);\\n    checkpoint += 1; score_add(1.0);\\n    if checkpoint == 6 { finished = true; ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Course complete! | R to restart\\\"); }\\n    else { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), true); }\\n  }\\n  if !finished { ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint \\\" + (checkpoint + 1) + \\\"/6 | elapsed \\\" + elapsed.to_int() + \\\"s | R restart\\\"); }\\n}\",\n    \"rootNodeUuid\": \"79ee533c-cc95-4bda-ac8c-b1e2b0a439ff\"\n  },\n  \"nodes\": [\n    {\n      \"uuid\": \"01a366e9-c11e-460d-a44c-69a3f9929120\",\n      \"type\": \"rhai.Call\",\n      \"title\": \"Call\",\n      \"category\": \"Language values\",\n      \"position\": {\n        \"x\": 4582,\n        \"y\": 1018\n      },\n      \"size\": {\n        \"width\": 256,\n        \"height\": 166\n      },\n      \"collapsed\": false,\n      \"pins\": [\n        {\n          \"uuid\": \"12a45c1a-de22-46cd-a454-551eddf847ee\",\n          \"key\": \"result\",\n          \"name\": \"Value\",\n          \"direction\": \"output\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"05c6b1e3-1ba3-4022-a0d9-7d2347ebfde7\",\n          \"key\": \"callee\",\n          \"name\": \"callee\",\n          \"direction\": \"input\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": true,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"3709f5dd-8879-4340-a82f-10f9c932f884\",\n          \"key\": \"arguments_0\",\n          \"na