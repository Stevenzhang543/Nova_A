ose.position_x + mx * 6.0 * dt;\\n  let y = pose.position_y + my * 6.0 * dt;\\n  if x < -8.0 { x = -8.0; } else if x > 8.0 { x = 8.0; }\\n  if y < -4.5 { y = -4.5; } else if y > 4.5 { y = 4.5; }\\n  set_position(x, y);\\n  \\n  \\n  let target = find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1));\\n  let dx = x - entity_position_x_on(target); let dy = y - entity_position_y_on(target);\\n  if dx * dx + dy * dy < 0.64 {\\n    entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), false);\\n    checkpoint += 1; score_add(1.0);\\n    if checkpoint == 6 { finished = true; ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Course complete! | R to restart\\\"); }\\n    else { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), true); }\\n  }\\n  if !finished { ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint \\\" + (checkpoint + 1) + \\\"/6 | elapsed \\\" + elapsed.to_int() + \\\"s | R restart\\\"); }\\n}\",\n        \"sourceColumn\": 1,\n        \"sourceEnd\": 2072,\n        \"sourceStart\": 533,\n        \"syntaxScopeId\": \"scope:module\"\n      }\n    },\n    {\n      \"uuid\": \"a1c1ce84-0855-468c-aaa8-9011d66e159b\",\n      \"type\": \"rhai.Call\",\n      \"title\": \"Call\",\n      \"category\": \"Language values\",\n      \"position\": {\n        \"x\": 3358,\n        \"y\": 2204\n      },\n      \"size\": {\n        \"width\": 256,\n        \"height\": 194\n      },\n      \"collapsed\": false,\n      \"pins\": [\n        {\n          \"uuid\": \"40f9d360-28c3-4efd-a17f-a8580d595c5d\",\n          \"key\": \"result\",\n          \"name\": \"Value\",\n          \"direction\": \"output\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"1463625c-c3ae-4946-a528-37a5d01bf254\",\n          \"key\": \"callee\",\n          \"name\": \"callee\"