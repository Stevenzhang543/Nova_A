ene Title\\\"), \\\"Coin Trail | Checkpoint 1/6 | WASD / arrows | R restart\\\"); return; }\\n  if finished { return; }\\n  elapsed += dt;\\n  let pose = transform();\\n  let mx = input_axis(\\\"MoveHorizontal\\\"); let my = input_axis(\\\"MoveVertical\\\");\\n  if mx != 0.0 && my != 0.0 { mx *= 0.7071067811865476; my *= 0.7071067811865476; }\\n  let x = pose.position_x + mx * 6.0 * dt;\\n  let y = pose.position_y + my * 6.0 * dt;\\n  if x < -8.0 { x = -8.0; } else if x > 8.0 { x = 8.0; }\\n  if y < -4.5 { y = -4.5; } else if y > 4.5 { y = 4.5; }\\n  set_position(x, y);\\n  \\n  \\n  let target = find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1));\\n  let dx = x - entity_position_x_on(target); let dy = y - entity_position_y_on(target);\\n  if dx * dx + dy * dy < 0.64 {\\n    entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), false);\\n    checkpoint += 1; score_add(1.0);\\n    if checkpoint == 6 { finished = true; ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Course complete! | R to restart\\\"); }\\n    else { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), true); }\\n  }\\n  if !finished { ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint \\\" + (checkpoint + 1) + \\\"/6 | elapsed \\\" + elapsed.to_int() + \\\"s | R restart\\\"); }\\n}\",\n        \"sourceColumn\": 15,\n        \"sourceEnd\": 2072,\n        \"sourceStart\": 547,\n        \"syntaxScopeId\": \"scope:module/function:update/1:1\"\n      }\n    },\n    {\n      \"uuid\": \"bcf07333-083d-4c0a-a9c7-748d227d3fb5\",\n      \"type\": \"rhai.Literal\",\n      \"title\": \"Literal\",\n      \"category\": \"Language values\",\n      \"position\": {\n        \"x\": 2606,\n        \"y\": 2176\n      },\n      \"size\": {\n        \"width\": 256,\n        \"height\": 108\n      },\n      \"collapsed\": false,\n      \"pins\": [\n        {\n          \"uuid\": \"e5d2e542-7c97-4b1c-add0-1c5d0f293546\",