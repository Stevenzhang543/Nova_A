      "source": "{\n  \"version\": 2,\n  \"locale\": \"de\",\n  \"fallbackLocale\": \"en\",\n  \"direction\": \"ltr\",\n  \"metadata\": {\n    \"displayName\": \"de\",\n    \"nativeName\": \"de\",\n    \"region\": \"\",\n    \"script\": \"\"\n  },\n  \"fontFallbacks\": [],\n  \"entries\": {\n    \"menu.title\": \"Nova Animiertes Menü\",\n    \"menu.playerName\": \"Spielername\",\n    \"menu.play\": \"Zwischensequenz starten\",\n    \"menu.pause\": \"Zwischensequenz pausieren\",\n    \"menu.skip\": \"Zwischensequenz überspringen\",\n    \"menu.resume\": \"Zwischensequenz fortsetzen\",\n    \"caption.intro\": \"Willkommen an Bord. Musik und Untertitel folgen derselben Zeitleiste.\",\n    \"caption.done\": \"Ankunft abgeschlossen. Setze die Einführung erneut fort.\"\n  },\n  \"contexts\": {\n    \"game.title\": \"Window and menu title\",\n    \"menu.play\": \"Primary menu action\",\n    \"menu.quit\": \"Exit action\"\n  }\n}",
