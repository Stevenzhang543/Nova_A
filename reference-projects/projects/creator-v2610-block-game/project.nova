      "assetType": "script",
      "mimeType": "text/x-rhai",
      "byteLength": 301,
      "source": "fn on_signal(name, payload, source) {\n  if name != \"snake.segment.1\" { return; }\n  let pose = transform();\n  let target_x = payload.x.to_float();\n  let target_y = payload.y.to_float();\n  set_position(target_x, target_y);\n  signal_emit(\"snake.segment.2\", #{ x: pose.position_x, y: pose.position_y });\n}",
