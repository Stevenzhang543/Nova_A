\n          \"name\": \"body 2\",\n          \"direction\": \"input\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"70b79bdc-5d55-429a-aa1e-f8cad1d5340f\",\n          \"key\": \"body_3\",\n          \"name\": \"body 3\",\n          \"direction\": \"input\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"0f72f1ce-1553-4c34-a9a5-7b678ccaaf9e\",\n          \"key\": \"body_4\",\n          \"name\": \"body 4\",\n          \"direction\": \"input\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"e127f221-365f-4792-ad43-62c2e9f41f5c\",\n          \"key\": \"body_5\",\n          \"name\": \"Add body\",\n          \"direction\": \"input\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        }\n      ],\n      \"config\": {\n        \"astId\": \"program\",\n        \"bindingId\": \"\",\n        \"fieldSpans\": {},\n        \"fields\": {},\n        \"originalFields\": {},\n        \"ownedComments\": [],\n        \"slots\": [\n          {\n            \"childId\": \"de2619f2-4e20-446e-a74a-e332adbb4231\",\n            \"end\": 70,\n            \"fallback\": \"\",\n            \"field\": \"body\",\n            \"index\": 0,\n            \"key\": \"body_0\",\n            \"start\": 0\n          },\n          {\n            \"childId\": \"dc4cd52f-bcb4-42f2-ab28-226c730b0185\",\n            \"end\": 146,\n            \"fallback\": \"\",\n            \"field\": \"body\",\n            \"index\": 1,\n            \"key\": \"body_1\",\n            \"start\": 71\n          },\n          {\n            \"childId\": \"ee77d541-ecb0-46a8-a02b-facb75825d6c\",\n            \"end\": 206,\n            \"fallback\": \"\",\n            \"field\": \"body\",\n            \"index\": 2,\n            \"key\": \"body_2\",\n            \"start\": 147\n          },\n          {\n            \"childId\": \"87dbe50e-5dc0-482e-a349-feed985c60e4\",\n            \"end\": 532,\n            \"fallback\": \"\",\n            \"field\": \"body\",\n            \"index\": 3,\n            \"key\": \"body_3\",\n            \"start\": 207\n          },\n          {\n            \"childId\": \"c598bdcf-d630-4a5d-a0c0-8ed5e869bdfc\",\n            \"end\": 2072,\n            \"fallback\": \"\",\n            \"field\": \"body\",\n            \"index\": 4,\n            \"key\": \"body_4\",\n            \"start\": 533\n          },\n          {\n            \"childId\": \"\",\n            \"end\": -1,\n            \"fallback\": \"\",\n            \"field\": \"body\",\n            \"index\": 5,\n            \"key\": \"body_5\",\n            \"start\": -1\n          }\n        ],\n        \"source\": \"@export(type=\\\"int\\\", min=0, max=8, group=\\\"Runtime\\\") let checkpoint = 0;\\n@export(type=\\\"float\\\", min=0, max=10000, group=\\\"Runtime\\\") let elapsed = 0.0;\\n@export(type=\\\"bool\\\", group=\\\"Runtime\\\") let finished = false;\\nfn start() { \\n  checkpoint = 0; elapsed = 0.0; finished = false; score_set(0.0); set_position(-7.5, -4.0);\\n  for index in 0..6 { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (index + 1)), index == 0); }\\n  ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint 1/6 | WASD / arrows | R restart\\\"); }\\nfn update(dt) {\\n  if input_pressed(\\\"Restart\\\") { \\n  checkpoint = 0; elapsed = 0.0; finished = false; score_set(0.0); set_position(-7.5, -4.0);\\n  for index in 0..6 { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (index + 1)), index == 0); }\\n  ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint 1/6 | WASD / arrows | R restart\\\"); return; }\\n  if finished { return; }\\n  elapsed += dt;\\n  let pose = transform();\\n  let mx = input_axis(\\\"MoveHorizontal\\\"); let my = input_axis(\\\"MoveVertical\\\");\\n  if mx != 0.0 && my != 0.0 { mx *= 0.7071067811865476; my *= 0.7071067811865476; }\\n  let x = pose.position_x + mx * 6.0 * dt;\\n  let y = pose.position_y + my * 6.0 * dt;\\n  if x < -8.0 { x = -8.0; } else if x > 8.0 { x = 8.0; }\\n  if y < -4.5 { y = -4.5; } else if y > 4.5 { y = 4.5; }\\n  set_position(x, y);\\n  \\n  \\n  let target = find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1));\\n  let dx = x - entity_position_x_on(target); let dy = y - entity_position_y_on(target);\\n  if dx * dx + dy * dy < 0.64 {\\n    entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), false);\\n    checkpoint += 1; score_add(1.0);\\n    if checkpoint == 6 { finished = true; ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Course complete! | R to restart\\\"); }\\n    else { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), true); }\\n  }\\n  if !finished { ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint \\\" + (checkpoint + 1) + \\\"/6 | elapsed \\\" + elapsed.to_int() + \\\"s | R restart\\\"); }\\n}\",\n        \"sourceColumn\": 1,\n        \"sourceEnd\": 2072,\n        \"sourceStart\": 0,\n        \"syntaxScopeId\": \"scope:module\"\n      }\n    },\n    {\n      \"uuid\": \"9ca19a38-98c7-432f-ac4f-4858f366754c\",\n      \"type\": \"rhai.Assignment\",\n      \"title\": \"Assignment\",\n      \"category\": \"Language values\",\n      \"position\": {\n        \"x\": 2034,\n        \"y\": 5248\n      },\n      \"size\": {\n        \"width\": 256,\n        \"height\": 138\n      },\n      \"collapsed\": false,\n      \"pins\": [\n        {\n          \"uuid\": \"58772719-4ad8-4dae-ab16-c0b95cfe6299\",\n          \"key\": \"result\"