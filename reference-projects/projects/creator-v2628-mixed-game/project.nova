\"x\": 1686,\n        \"y\": 5422\n      },\n      \"size\": {\n        \"width\": 256,\n        \"height\": 108\n      },\n      \"collapsed\": false,\n      \"pins\": [\n        {\n          \"uuid\": \"d5419e14-a078-4bad-a935-78908eb580ff\",\n          \"key\": \"result\",\n          \"name\": \"Value\",\n          \"direction\": \"output\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        }\n      ],\n      \"config\": {\n        \"astId\": \"scope:module/function:update/1:1/block:1/node:Literal:350ca8af:1\",\n        \"bindingId\": \"\",\n        \"fieldSpans\": {\n          \"raw\": [\n            0,\n            1\n          ]\n        },\n        \"fields\": {\n          \"literalKind\": \"integer\",\n          \"raw\": \"0\"\n        },\n        \"originalFields\": {\n          \"literalKind\": \"integer\",\n          \"raw\": \"0\"\n        },\n        \"ownedComments\": [],\n        \"slots\": [],\n        \"source\": \"0\",\n        \"sourceColumn\": 16,\n        \"sourceEnd\": 598,\n        \"sourceStart\": 597,\n        \"syntaxScopeId\": \"scope:module/function:update/1:1/block:1\"\n      }\n    },\n    {\n      \"uuid\": \"c598bdcf-d630-4a5d-a0c0-8ed5e869bdfc\",\n      \"type\": \"rhai.FunctionDeclaration\",\n      \"title\": \"Function Declaration · update\",\n      \"category\": \"Language flow\",\n      \"position\": {\n        \"x\": 126,\n        \"y\": 3734\n      },\n      \"size\": {\n        \"width\": 256,\n        \"height\": 166\n      },\n      \"collapsed\": false,\n      \"pins\": [\n        {\n          \"uuid\": \"e1590932-25c4-4c0b-aecc-ab5082ea2099\",\n          \"key\": \"result\",\n          \"name\": \"Value\",\n          \"direction\": \"output\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"eb63b890-bd8c