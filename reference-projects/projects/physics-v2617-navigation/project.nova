    {
      "uuid": "19e18004-6342-4c48-89e1-800463425c48",
      "name": "EnemyPatrol.rhai",
      "path": "Assets/Scripts/EnemyPatrol.rhai",
      "assetType": "script",
      "mimeType": "text/x-rhai",
      "byteLength": 432,
      "source": "@export(type=\"float\", min=0, max=20, step=0.1, group=\"AI\", tooltip=\"Patrol movement speed\") let patrol_speed = 2.0;\nfn fixed_update(dt) {\n  let pose = transform();\n  let body = rigid_body();\n  if pose.position_x > 7.0 { set_velocity(-patrol_speed, body.velocity_y); }\n  else if pose.position_x < 2.0 { set_velocity(patrol_speed, body.velocity_y); }\n  else if body.velocity_x == 0.0 { set_velocity(patrol_speed, body.velocity_y); }\n}",
