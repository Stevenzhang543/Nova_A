        "status": "ready",
        "lastValidSource": "{\n  \"format\": \"nova-graph\",\n  \"version\": 1,\n  \"apiVersion\": 2,\n  \"uuid\": \"ad5d51ae-ba33-4dc2-ad41-7d6f67fc4627\",\n  \"name\": \"CheckpointGame\",\n  \"variables\": [],\n  \"routines\": [],\n  \"customEvents\": [],\n  \"interfaces\": [],\n  \"libraries\": [],\n  \"debug\": {\n    \"breakpoints\": [],\n    \"watches\": [],\n    \"breakOnError\": true,\n    \"coverageEnabled\": true\n  },\n  \"migrations\": [],\n  \"language\": {\n    \"version\": 1,\n    \"source\": \"@export(type=\\\"int\\\", min=0, max=8, group=\\\"Runtime\\\") let checkpoint = 0;\\n@export(type=\\\"float\\\", min=0, max=10000, group=\\\"Runtime\\\") let elapsed = 0.0;\\n@export(type=\\\"bool\\\", group=\\\"Runtime\\\") let finished = false;\\nfn start() { \\n  checkpoint = 0; elapsed = 0.0; finished = false; score_set(0.0); set_position(-7.5, -4.0);\\n  for index in 0..6 { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (index + 1)), index == 0); }\\n  ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint 1/6 | WASD / arrows | R restart\\\"); }\\nfn update(dt) {\\n  if input_pressed(\\\"Restart\\\") { \\n  checkpoint = 0; elapsed = 0.0; finished = false; score_set(0.0); set_position(-7.5, -4.0);\\n  for index in 0..6 { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (index + 1)), index == 0); }\\n  ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint 1/6 | WASD / arrows | R restart\\\"); return; }\\n  if finished { return; }\\n  elapsed += dt;\\n  let pose = transform();\\n  let mx = input_axis(\\\"MoveHorizontal\\\"); let my = input_axis(\\\"MoveVertical\\\");\\n  if mx != 0.0 && my != 0.0 { mx *= 0.7071067811865476; my *= 0.7071067811865476; }\\n  let x = pose.position_x + mx * 6.0 * dt;\\n  let y = pose.position_y + my * 6.0 * dt;\\n  if x < -8.0 { x = -8.0; } else if x > 8.0 { x = 8.0; }\\n  if y < -4.5 { y = -4.5; } else if y > 4.5 { y = 4.5; }\\n  set_position(x, y);\\n  \\n  \\n  let xs = [-6.0, -3.0, 0.0, 3.0, 6.0, 0.0]; let ys = [-2.0, 1.0, 3.0, 1.0, -2.0, -3.0];\\n  let dx = x - xs[checkpoint]; let dy = y - ys[checkpoint];\\n  if dx * dx + dy * dy < 0.64 {\\n    entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), false);\\n    checkpoint += 1; score_add(1.0);\\n    if checkpoint == 6 { finished = true; ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Course complete! | R to restart\\\"); }\\n    else { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), true); }\\n  }\\n  if !finished { ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint \\\" + (checkpoint + 1) + \\\"/6 | elapsed \\\" + elapsed.to_int() + \\\"s | R restart\\\"); }\\n}\",\n    \"rootNodeUuid\": \"441d8e73-5420-457d-a524-d4a37f0bddea\"\n  },\n  \"nodes\": [\n    {\n      \"uuid\": \"004fdff4-7efb-4e6f-a86d-37d1ce3dd628\",\n      \"type\": \"rhai.VariableDeclaration\",\n      \"title\": \"Variable Declaration · my\",\n      \"category\": \"Language flow\",\n      \"position\": {\n        \"x\": 6838,\n        \"y\": 4586\n      },\n      \"size\": {\n        \"width\": 256,\n        \"height\": 138\n      },\n      \"collapsed\": false,\n      \"pins\": [\n        {\n          \"uuid\": \"dde8d2f9-0e3c-48f9-ab03-67d1bb2835b3\",\n          \"key\": \"result\",\n          \"name\": \"Value\",\n          \"direction\": \"output\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"ebd93f89-7748-421e-a9be-53273db966cf\",\n          \"key\": \"initializer\",\n          \"name\": \"initializer\",\n          \"direction\": \"input\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": true,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"eeb9d476-64bb-40d6-a7e4-aede08098cea\",\n          \"key\": \"metadata_0\",\n          \"name\": \"Add metadata\",\n          \"direction\": \"input\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        }\n      ],\n      \"config\": {\n        \"astId\": \"scope:module/function:update/1:1/node:VariableDeclaration:my:1\",\n        \"bindingId\": \"scope:module/function:update/1:1/binding:local:my:1\",\n        \"fieldSpans\": {\n          \"name\": [\n            4,\n            6\n          ]\n        },\n        \"fields\": {\n          \"declarationKind\": \"let\",\n          \"exported\": false,\n          \"name\": \"my\",\n          \"terminated\": true\n        },\n        \"originalFields\": {\n          \"declarationKind\": \"let\",\n          \"exported\": false,\n          \"name\": \"my\",\n          \"terminated\": true\n        },\n        \"ownedComments\": [],\n        \"slots\": [\n          {\n            \"childId\": \"a2fd847a-0d20-4474-a0c7-900cbc39e069\",\n            \"end\": 35,\n            \"fallback\": \"\",\n            \"field\": \"initializer\",\n            \"index\": -1,\n            \"key\": \"initializer\",\n            \"start\": 9\n          },\n          {\n            \"childId\": \"\",\n            \"end\": -1,\n            \"fallback\": \"\",\n            \"field\": \"metadata\",\n            \"index\": 0,\n            \"key\": \"metadata_0\",\n            \"start\": -1\n          }\n        ],\n        \"source\": \"let my = input_axis(\\\"MoveVertical\\\");\",\n        \"sourceColumn\": 42,\n        \"sourceEnd\": 1048,\n        \"sourceStart\": 1012,\n        \"syntaxScopeId\": \"scope:module/function:update/1:1\"\n      }\n    },\n    {\n      \"uuid\": \"00769413-8a7b-4b25-a449-a17293fbd16e\",\n      \"type\": \"rhai.Identifier\",\n      \"title\": \"Identifier · checkpoint\",\n      \"category\": \"Language values\",\n      \"position\": {\n        \"x\": 2258,\n     