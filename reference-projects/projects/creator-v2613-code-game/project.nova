\\n  let xs = [-6.0, -3.0, 0.0, 3.0, 6.0, 0.0]; let ys = [-2.0, 1.0, 3.0, 1.0, -2.0, -3.0];\\n  let dx = x - xs[checkpoint]; let dy = y - ys[checkpoint];\\n  if dx * dx + dy * dy < 0.64 {\\n    entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), false);\\n    checkpoint += 1; score_add(1.0);\\n    if checkpoint == 6 { finished = true; ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Course complete! | R to restart\\\"); }\\n    else { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), true); }\\n  }\\n  if !finished { ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint \\\" + (checkpoint + 1) + \\\"/6 | elapsed \\\" + elapsed.to_int() + \\\"s | R restart\\\"); }\\n}\",\n    \"rootNodeUuid\": \"441d8e73-5420-457d-a524-d4a37f0bddea\"\n  },\n  \"nodes\": [\n    {\n      \"uuid\": \"004fdff4-7efb-4e6f-a86d-37d1ce3dd628\",\n      \"type\": \"rhai.VariableDeclaration\",\n      \"title\": \"Variable Declaration · my\",\n      \"category\": \"Language flow\",\n      \"position\": {\n        \"x\": 6838,\n        \"y\": 4586\n      },\n      \"size\": {\n        \"width\": 256,\n        \"height\": 138\n      },\n      \"collapsed\": false,\n      \"pins\": [\n        {\n          \"uuid\": \"dde8d2f9-0e3c-48f9-ab03-67d1bb2835b3\",\n          \"key\": \"result\",\n          \"name\": \"Value\",\n          \"direction\": \"output\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"ebd93f89-7748-421e-a9be-53273db966cf\",\n          \"key\": \"initializer\",\n          \"name\": \"initializer\",\n          \"direction\": \"input\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": true,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"eeb9d476-64bb-40d6-a7e4-aede08098cea\",\n       