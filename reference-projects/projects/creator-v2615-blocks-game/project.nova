\\n  let xs = [-6.0, -3.0, 0.0, 3.0, 6.0, 0.0]; let ys = [-2.0, 1.0, 3.0, 1.0, -2.0, -3.0];\\n  let dx = x - xs[checkpoint]; let dy = y - ys[checkpoint];\\n  if dx * dx + dy * dy < 0.64 {\\n    entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), false);\\n    checkpoint += 1; score_add(1.0);\\n    if checkpoint == 6 { finished = true; ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Course complete! | R to restart\\\"); }\\n    else { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), true); }\\n  }\\n  if !finished { ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint \\\" + (checkpoint + 1) + \\\"/6 | elapsed \\\" + elapsed.to_int() + \\\"s | R restart\\\"); }\\n}\",\n    \"rootNodeUuid\": \"03f029fb-83c7-4464-a57d-9f7cd60589e3\"\n  },\n  \"nodes\": [\n    {\n      \"uuid\": \"00193228-dc28-4c64-ab89-250b14bdfe72\",\n      \"type\": \"rhai.Index\",\n      \"title\": \"Index\",\n      \"category\": \"Language values\",\n      \"position\": {\n        \"x\": 6882,\n        \"y\": 8484\n      },\n      \"size\": {\n        \"width\": 256,\n        \"height\": 138\n      },\n      \"collapsed\": false,\n      \"pins\": [\n        {\n          \"uuid\": \"949e9984-3951-43a9-a6ec-b8667261cb3e\",\n          \"key\": \"result\",\n          \"name\": \"Value\",\n          \"direction\": \"output\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"4b7b07e9-5cc4-4f1f-a184-87833324a00c\",\n          \"key\": \"object\",\n          \"name\": \"object\",\n          \"direction\": \"input\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": true,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"5a0a4bb5-0598-4d11-aa4b-e043da760423\",\n          \"key\": \"index\",\n          \"name\"