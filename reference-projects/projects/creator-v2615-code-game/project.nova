\\n  let xs = [-6.0, -3.0, 0.0, 3.0, 6.0, 0.0]; let ys = [-2.0, 1.0, 3.0, 1.0, -2.0, -3.0];\\n  let dx = x - xs[checkpoint]; let dy = y - ys[checkpoint];\\n  if dx * dx + dy * dy < 0.64 {\\n    entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), false);\\n    checkpoint += 1; score_add(1.0);\\n    if checkpoint == 6 { finished = true; ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Course complete! | R to restart\\\"); }\\n    else { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), true); }\\n  }\\n  if !finished { ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint \\\" + (checkpoint + 1) + \\\"/6 | elapsed \\\" + elapsed.to_int() + \\\"s | R restart\\\"); }\\n}\",\n    \"rootNodeUuid\": \"4793b1bd-117b-4616-abc2-164bcc2a6e4a\"\n  },\n  \"nodes\": [\n    {\n      \"uuid\": \"0026cdac-2c73-4c0a-a142-56e223ebdfbe\",\n      \"type\": \"rhai.ExpressionStatement\",\n      \"title\": \"Expression Statement\",\n      \"category\": \"Language flow\",\n      \"position\": {\n        \"x\": 3830,\n        \"y\": 872\n      },\n      \"size\": {\n        \"width\": 256,\n        \"height\": 110\n      },\n      \"collapsed\": false,\n      \"pins\": [\n        {\n          \"uuid\": \"07acb29e-b288-42ca-af94-b221029cbf2c\",\n          \"key\": \"result\",\n          \"name\": \"Value\",\n          \"direction\": \"output\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"5cd9dfd3-cb48-4a35-a4a9-adbd5704e700\",\n          \"key\": \"expression\",\n          \"name\": \"expression\",\n          \"direction\": \"input\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": true,\n          \"defaultValue\": null\n        }\n      ],\n      \"config\": {\n        \"astId\": \"scope:module/function:start/0:1/node:E