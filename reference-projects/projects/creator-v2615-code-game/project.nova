.to_int() + \\\"s | R restart\\\"); }\\n}\",\n        \"sourceColumn\": 15,\n        \"sourceEnd\": 2064,\n        \"sourceStart\": 547,\n        \"syntaxScopeId\": \"scope:module/function:update/1:1\"\n      }\n    },\n    {\n      \"uuid\": \"fa0f113c-8820-4158-ad41-c71d8265b8fb\",\n      \"type\": \"rhai.Literal\",\n      \"title\": \"Literal\",\n      \"category\": \"Language values\",\n      \"position\": {\n        \"x\": 5378,\n        \"y\": 12192\n      },\n      \"size\": {\n        \"width\": 256,\n        \"height\": 108\n      },\n      \"collapsed\": false,\n      \"pins\": [\n        {\n          \"uuid\": \"e678b89b-21ab-431d-aede-e1691681de01\",\n          \"key\": \"result\",\n          \"name\": \"Value\",\n          \"direction\": \"output\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        }\n      ],\n      \"config\": {\n        \"astId\": \"scope:module/function:update/1:1/block:9/node:Literal:340ca71c:1\",\n        \"bindingId\": \"\",\n        \"fieldSpans\": {\n          \"raw\": [\n            0,\n            1\n          ]\n        },\n        \"fields\": {\n          \"literalKind\": \"integer\",\n          \"raw\": \"1\"\n        },\n        \"originalFields\": {\n          \"literalKind\": \"integer\",\n          \"raw\": \"1\"\n        },\n        \"ownedComments\": [],\n        \"slots\": [],\n        \"source\": \"1\",\n        \"sourceColumn\": 111,\n        \"sourceEnd\": 2002,\n        \"sourceStart\": 2001,\n        \"syntaxScopeId\": \"scope:module/function:update/1:1/block:9\"\n      }\n    },\n    {\n      \"uuid\": \"fac00d41-9232-4f53-a362-01539f28f10e\",\n      \"type\": \"rhai.VariableDeclaration\",\n      \"title\": \"Variable Declaration · x\",\n      \"category\": \"Language flow\",\n      \"position\": {\n        \"x\": 9038,\n        \"y\": 4586\n      },\n      \"size\": {\n        \"width\": 256,\n        \"height\": 138\n