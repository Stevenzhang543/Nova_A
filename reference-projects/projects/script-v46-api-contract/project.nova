      "mimeType": "text/x-rhai",
      "byteLength": 357,
      "source": "// Nova_A API v2 contract fixture: lifecycle\n// Representative binding: awake\n// @test tags=api,contract,lifecycle timeout=1000 seed=460\nfn test_api_lifecycle() {\n  expect(api_current_version() == 2, \"API v2 engine\");\n  expect(api_minimum_version() == 1, \"API v1 adapter\");\n  expect(api_namespace(\"awake\") == \"lifecycle\", \"lifecycle namespace metadata\");\n}\n",
