\n          \"uuid\": \"196da006-00ca-4f5a-acdd-546b6a813d48\",\n          \"key\": \"result\",\n          \"name\": \"Value\",\n          \"direction\": \"output\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"5bbd4fed-c350-4925-aab0-498001d0e236\",\n          \"key\": \"parameters_0\",\n          \"name\": \"parameters 0\",\n          \"direction\": \"input\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"7edfc8f6-a619-45b9-ae7f-1564801591d8\",\n          \"key\": \"body\",\n          \"name\": \"body\",\n          \"direction\": \"input\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": true,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"bd3148d3-0d7b-48d6-abd0-6c99289d067f\",\n          \"key\": \"parameters_1\",\n          \"name\": \"Add parameters\",\n          \"direction\": \"input\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        }\n      ],\n      \"config\": {\n        \"astId\": \"scope:module/node:FunctionDeclaration:update/1:1\",\n        \"bindingId\": \"scope:module/binding:function:update/1:1\",\n        \"fieldSpans\": {\n          \"name\": [\n            3,\n            9\n          ]\n        },\n        \"fields\": {\n          \"name\": \"update\",\n          \"private\": false\n        },\n        \"originalFields\": {\n          \"name\": \"update\",\n          \"private\": false\n        },\n        \"ownedComments\": [],\n        \"slots\": [\n          {\n            \"childId\": \"cf46dd23-8fec-4857-a481-f3b113bb4882\",\n            \"end\": 12,\n            \"fallback\": \"\",\n            \"field\": \"parameters\",\n            \"index\": 0,\n            \"key\": \"parameters_0\",\n            \"start\": 10\n          },\n          {\n            \"childId\": \"6060bf9a-76e1-4d31-aa38-0e0e10fec25a\",\n            \"end\": 1531,\n            \"fallback\": \"\",\n            \"field\": \"body\",\n            \"index\": -1,\n            \"key\": \"body\",\n            \"start\": 14\n          },\n          {\n            \"childId\": \"\",\n            \"end\": -1,\n            \"fallback\": \"\",\n            \"field\": \"parameters\",\n            \"index\": 1,\n            \"key\": \"parameters_1\",\n            \"start\": -1\n          }\n        ],\n        \"source\": \"fn update(dt) {\\n  if input_pressed(\\\"Restart\\\") { \\n  checkpoint = 0; elapsed = 0.0; finished = false; score_set(0.0); set_position(-7.5, -4.0);\\n  for index in 0..6 { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (index + 1)), index == 0); }\\n  ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint 1/6 | WASD / arrows | R restart\\\"); return; }\\n  if finished { return; }\\n  elapsed += dt;\\n  let pose = transform();\\n  let mx = input_axis(\\\"MoveHorizontal\\\"); let my = input_axis(\\\"MoveVertical\\\");\\n  if mx != 0.0 && my != 0.0 { mx *= 0.7071067811865476; my *= 0.7071067811865476; }\\n  let x = pose.position_x + mx * 6.0 * dt;\\n  let y = pose.position_y + my * 6.0 * dt;\\n  if x < -8.0 { x = -8.0; } else if x > 8.0 { x = 8.0; }\\n  if y < -4.5 { y = -4.5; } else if y > 4.5 { y = 4.5; }\\n  set_position(x, y);\\n  \\n  \\n  let xs = [-6.0, -3.0, 0.0, 3.0, 6.0, 0.0]; let ys = [-2.0, 1.0, 3.0, 1.0, -2.0, -3.0];\\n  let dx = x - xs[checkpoint]; let dy = y - ys[checkpoint];\\n  if dx * dx + dy * dy < 0.64 {\\n    entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), false);\\n    checkpoint += 1; score_add(1.0);\\n    if checkpoint == 6 { finished = true; ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Course complete! | R to restart\\\"); }\\n    else { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), true); }\\n  }\\n  if !finished { ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint \\\" + (checkpoint + 1) + \\\"/6 | elapsed \\\" + elapsed.to_int() + \\\"s | R restart\\\"); }\\n}\",\n        \"sourceColumn\": 1,\n        \"sourceEnd\": 2064,\n        \"sourceStart\": 533,\n        \"syntaxScopeId\": \"scope:module\"\n      }\n    },\n    {\n      \"uuid\": \"50a2b58e-64d7-4786-a1cd-8d57e68c5f08\",\n      \"type\": \"rhai.Literal\",\n      \"title\": \"Literal\",\n      \"category\": \"Language values\",\n      \"position\": {\n        \"x\": 1800,\n        \"y\": 148\n      },\n      \"size\": {\n        \"width\": 256,\n        \"height\": 108\n      },\n      \"collapsed\": false,\n      \"pins\": [\n        {\n          \"uuid\": \"2967d269-71be-47f6-a137-26189a3adb5d\",\n          \"key\": \"result\",\n          \"name\": \"Value\",\n          \"direction\": \"output\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        }\n      ],\n      \"config\": {\n        \"astId\": \"scope:module/function:start/0:1/node:Literal:a620f805:1\",\n        \"bindingId\": \"\",\n        \"fieldSpans\": {\n          \"raw\": [\n            0,\n            3\n          ]\n        },\n        \"fields\": {\n          \"literalKind\": \"float\",\n          \"raw\": \"4.0\"\n        },\n        \"originalFields\": {\n          \"literalKind\": \"float\",\n          \"raw\": \"4.0\"\n        },\n        \"ownedComments\": [],\n        \"slots\": [],\n        \"source\": \"4.0\",\n        \"sourceColumn\": 88,\n        \"sourceEnd\": 311,\n        \"sourceStart\": 308,\n        \"syntaxScopeId\": \"scope:module/function:start/0:1\"\n      }\n    },\n    {\n      \"uuid\": \"52701540-3235-4434-a7d1-5f67d8a4f86e\",\n      \"type