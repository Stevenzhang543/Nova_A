\\n  let xs = [-6.0, -3.0, 0.0, 3.0, 6.0, 0.0]; let ys = [-2.0, 1.0, 3.0, 1.0, -2.0, -3.0];\\n  let dx = x - xs[checkpoint]; let dy = y - ys[checkpoint];\\n  if dx * dx + dy * dy < 0.64 {\\n    entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), false);\\n    checkpoint += 1; score_add(1.0);\\n    if checkpoint == 6 { finished = true; ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Course complete! | R to restart\\\"); }\\n    else { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), true); }\\n  }\\n  if !finished { ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint \\\" + (checkpoint + 1) + \\\"/6 | elapsed \\\" + elapsed.to_int() + \\\"s | R restart\\\"); }\\n}\",\n    \"rootNodeUuid\": \"81120c53-447f-4042-a2eb-359d780f4659\"\n  },\n  \"nodes\": [\n    {\n      \"uuid\": \"0216e9cc-33ca-4bd4-a232-4b22c2c3798c\",\n      \"type\": \"rhai.Identifier\",\n      \"title\": \"Identifier · finished\",\n      \"category\": \"Language values\",\n      \"position\": {\n        \"x\": 3942,\n        \"y\": 1192\n      },\n      \"size\": {\n        \"width\": 256,\n        \"height\": 108\n      },\n      \"collapsed\": false,\n      \"pins\": [\n        {\n          \"uuid\": \"ad2c096b-fc1d-47e3-ac35-3fcf4d98e106\",\n          \"key\": \"result\",\n          \"name\": \"Value\",\n          \"direction\": \"output\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        }\n      ],\n      \"config\": {\n        \"astId\": \"scope:module/function:start/0:1/node:Identifier:finished:1\",\n        \"bindingId\": \"scope:module/binding:global:finished:1\",\n        \"fieldSpans\": {\n          \"name\": [\n            0,\n            8\n          ]\n        },\n        \"fields\": {\n          \"name\": \"finished\"\n        },\n        \"originalFields\": {\n          \"name\": \"finished\"\n