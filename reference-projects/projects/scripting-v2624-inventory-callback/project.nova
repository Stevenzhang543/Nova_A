"name\": \"body 1\",\n          \"direction\": \"input\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"913ee51f-7ef6-4a33-a36c-9a597a4aecec\",\n          \"key\": \"body_2\",\n          \"name\": \"body 2\",\n          \"direction\": \"input\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"b7599760-0fbb-476e-ad41-a67e548b9cf6\",\n          \"key\": \"body_3\",\n          \"name\": \"body 3\",\n          \"direction\": \"input\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"52b872b6-b312-4979-a47a-3f66b9a4004a\",\n          \"key\": \"body_4\",\n          \"name\": \"body 4\",\n          \"direction\": \"input\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"3d87f60f-e823-4a61-a86f-833b8d01eae7\",\n          \"key\": \"body_5\",\n          \"name\": \"body 5\",\n          \"direction\": \"input\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"b3850942-2bd1-4ed0-a4aa-652c09bb36d6\",\n          \"key\": \"body_6\",\n          \"name\": \"body 6\",\n          \"direction\": \"input\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"50f94d5c-bf91-4b03-af9d-bc329ad6526f\",\n          \"key\": \"body_7\",\n          \"name\": \"body 7\",\n          \"direction\": \"input\",\n          \"kin