l\n        },\n        {\n          \"uuid\": \"d0bce39f-4da2-419b-a112-96f387cce71e\",\n          \"key\": \"body\",\n          \"name\": \"body\",\n          \"direction\": \"input\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": true,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"0a163f02-1ed3-46fc-ad61-1941641e907e\",\n          \"key\": \"parameters_1\",\n          \"name\": \"Add parameters\",\n          \"direction\": \"input\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        }\n      ],\n      \"config\": {\n        \"astId\": \"scope:module/node:FunctionDeclaration:update/1:1\",\n        \"bindingId\": \"scope:module/binding:function:update/1:1\",\n        \"fieldSpans\": {\n          \"name\": [\n            3,\n            9\n          ]\n        },\n        \"fields\": {\n          \"name\": \"update\",\n          \"private\": false\n        },\n        \"originalFields\": {\n          \"name\": \"update\",\n          \"private\": false\n        },\n        \"ownedComments\": [],\n        \"slots\": [\n          {\n            \"childId\": \"9898eb61-921e-4f4e-a892-20fe9dc0066e\",\n            \"end\": 12,\n            \"fallback\": \"\",\n            \"field\": \"parameters\",\n            \"index\": 0,\n            \"key\": \"parameters_0\",\n            \"start\": 10\n          },\n          {\n            \"childId\": \"9641211d-d02f-4043-ac7e-b8775f9e361e\",\n            \"end\": 1539,\n            \"fallback\": \"\",\n            \"field\": \"body\",\n            \"index\": -1,\n            \"key\": \"body\",\n            \"start\": 14\n          },\n          {\n            \"childId\": \"\",\n            \"end\": -1,\n            \"fallback\": \"\",\n            \"field\": \"parameters\",\n            \"index\": 1,\n            \"key\": \"parameters_1\",\n            \"start\": -1\n          }\n        ],\n        \"source\": \"fn update(dt) {\\n  if input_pressed(\\\"Restart\\\") { \\n  checkpoint = 0; elapsed = 0.0; finished = false; score_set(0.0); set_position(-7.5, -4.0);\\n  for index in 0..6 { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (index + 1)), index == 0); }\\n  ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint 1/6 | WASD / arrows | R restart\\\"); return; }\\n  if finished { return; }\\n  elapsed += dt;\\n  let pose = transform();\\n  let mx = input_axis(\\\"MoveHorizontal\\\"); let my = input_axis(\\\"MoveVertical\\\");\\n  if mx != 0.0 && my != 0.0 { mx *= 0.7071067811865476; my *= 0.7071067811865476; }\\n  let x = pose.position_x + mx * 6.0 * dt;\\n  let y = pose.position_y + my * 6.0 * dt;\\n  if x < -8.0 { x = -8.0; } else if x > 8.0 { x = 8.0; }\\n  if y < -4.5 { y = -4.5; } else if y > 4.5 { y = 4.5; }\\n  set_position(x, y);\\n  \\n  \\n  let target = find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1));\\n  let dx = x - entity_position_x_on(target); let dy = y - entity_position_y_on(target);\\n  if dx * dx + dy * dy < 0.64 {\\n    entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), false);\\n    checkpoint += 1; score_add(1.0);\\n    if checkpoint == 6 { finished = true; ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Course complete! | R to restart\\\"); }\\n    else { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), true); }\\n  }\\n  if !finished { ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint \\\" + (checkpoint + 1) + \\\"/6 | elapsed \\\" + elapsed.to_int() + \\\"s | R restart\\\"); }\\n}\",\n        \"sourceColumn\": 1,\n        \"sourceEnd\": 2072,\n        \"sourceStart\": 533,\n        \"syntaxScopeId\": \"scope:module\"\n      }\n    },\n    {\n      \"uuid\": \"f493d338-a98a-42d7-a78f-fd189bb073ce\",\n      \"type\": \"rhai.Call\",\n      \"t