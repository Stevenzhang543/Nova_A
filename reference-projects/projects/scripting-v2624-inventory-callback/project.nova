        "lastValidSource": "use \"InventoryHelper.rhai\";\n@export let inventory = #{coins: 0, items: [\"starter\"]};\n@export let elapsed = 0.0;\nfn start(){let callback=Fn(\"inventory_callback\");inventory.coins=callback.call(inventory.coins);inventory.items.push(\"reward\");spawn_at(\"asset://690915c1-68d8-4023-af73-74d916aa8231\",2.0,0.0,0.0,1.0,1.0);show_inventory(inventory);}\nfn show_inventory(inventory){ui_set_text_on(find_entity_handle(\"Scene Title\"),\"Inventory coins: \"+inventory.coins+\" | items: \"+inventory.items.len()+\" | module + callback + spawned reward\");}\nfn update(dt){elapsed+=dt;show_inventory(inventory);}\n",
