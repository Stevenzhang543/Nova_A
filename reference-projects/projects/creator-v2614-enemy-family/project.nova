          "x": 0.5,
          "y": 0.5
        },
        "atlas": false
      },
      "pipeline": {
        "importerVersion": "template-4.2",
        "platform": "web",
        "sourceHash": "1156eeee6be9047b5d988b436cace512ef77474c73baaf67817b48c081ab0625",
