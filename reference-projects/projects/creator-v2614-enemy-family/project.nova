    {
      "uuid": "6a10dc91-c28d-4ebf-a20e-537efc574145",
      "name": "Enemy Family.rhai",
      "path": "Assets/Scripts/Enemy Family.rhai",
      "assetType": "script",
      "mimeType": "text/x-rhai",
      "byteLength": 421,
      "source": "// Shared behavior owns collision and task counters.\n@export(type=\"int\") let collision_count = 0;\n@export(type=\"int\") let task_count = 0;\nfn family_awake() { task_wait(\"family_ready\", 0.2); }\nfn family_collision(other, px, py, nx, ny, rvx, rvy) { collision_count += 1; log_info(\"FAMILY_COLLISION\"); }\nfn family_task(name) { task_count += 1; log_info(\"FAMILY_TASK\"); }\nfn family_destroy() { log_debug(\"FAMILY_DESTROY\"); }\n",
      "sourceModified": 0,
      "importedAt": 0,
      "width": 0,
      "height": 0,
      "duration": 0,
      "fontFamily": "",
      "settings": {
