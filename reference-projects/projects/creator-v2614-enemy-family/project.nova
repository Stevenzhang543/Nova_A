    {
      "uuid": "716df26e-ef8e-4caa-a407-0cc9483df373",
      "name": "Scout Enemy.rhai",
      "path": "Assets/Scripts/Scout Enemy.rhai",
      "assetType": "script",
      "mimeType": "text/x-rhai",
      "byteLength": 333,
      "source": "// Instance value and shared inherited behavior are separate.\n@export(type=\"float\", min=0, max=30, step=0.1) let move_speed = 6.0;\nfn scout_start() { move_speed += 1.0; set_velocity(move_speed * 0.025, 0.0); }\nfn scout_signal(name, payload, source) { log_info(\"SCOUT_SIGNAL\"); }\nfn scout_return(name, payload, source) { despawn(); }\n",
