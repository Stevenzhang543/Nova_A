        "lastValidSource": "@export(type=\"data\", serialize=false, group=\"Runtime\") let scored = [];\n@export(type=\"int\", min=1, max=64, step=1, group=\"Game\", tooltip=\"Targets that must leave the camera view\") let remaining = 8;\nfn reset_wave() {\n  score_set(0.0);\n  entity_set_enabled(find_entity_handle(\"Congratulations Bar\"), false);\n  entity_set_enabled(find_entity_handle(\"Congratulations Text\"), false);\n  ui_set_text_on(find_entity_handle(\"Score Text\"), \"Score  0 / 8\");\n  spawn_at(\"asset://69ae9ed6-1f63-48f2-89ae-9ed61f63e8f2\", -6.0, -3.8, 0.0, 1.0, 1.0);\n  spawn_at(\"asset://69ae9ed6-1f63-48f2-89ae-9ed61f63e8f2\", -2.2, -3.4, 0.0, 1.0, 1.0);\n  spawn_at(\"asset://69ae9ed6-1f63-48f2-89ae-9ed61f63e8f2\", 2.2, -3.4, 0.0, 1.0, 1.0);\n  spawn_at(\"asset://69ae9ed6-1f63-48f2-89ae-9ed61f63e8f2\", 6.0, -3.8, 0.0, 1.0, 1.0);\n  spawn_at(\"asset://69ae9ed6-1f63-48f2-89ae-9ed61f63e8f2\", -6.0, 3.8, 0.0, 1.0, 1.0);\n  spawn_at(\"asset://69ae9ed6-1f63-48f2-89ae-9ed61f63e8f2\", -2.2, 3.4, 0.0, 1.0, 1.0);\n  spawn_at(\"asset://69ae9ed6-1f63-48f2-89ae-9ed61f63e8f2\", 2.2, 3.4, 0.0, 1.0, 1.0);\n  spawn_at(\"asset://69ae9ed6-1f63-48f2-89ae-9ed61f63e8f2\", 6.0, 3.8, 0.0, 1.0, 1.0);\n  timer_start(\"bounds\", 0.05, true);\n}\nfn on_timer(name) {\n  if name != \"bounds\" || remaining <= 0 { return; }\n  let previous = remaining;\n  let margin = 0.8;\n  for target in query_group(\"knockout-target\", 16) {\n    if scored.contains(target.id) { continue; }\n    let x = entity_position_x_on(target);\n    let y = entity_position_y_on(target);\n    if x < view_min_x() - margin || x > view_max_x() + margin || y < view_min_y() - margin || y > view_max_y() + margin {\n      scored.push(target.id);\n      signal_emit_to(target.id, \"enemy.return\", #{});\n      score_add(1.0);\n      remaining = remaining - 1;\n    }\n  }\n  if remaining != previous {\n    ui_set_text_on(find_entity_handle(\"Score Text\"), `Score  ${8 - remaining} / 8`);\n  }\n  if remaining == 0 {\n    timer_cancel(\"bounds\");\n    entity_set_enabled(find_entity_handle(\"Congratulations Bar\"), true);\n    entity_set_enabled(find_entity_handle(\"Congratulations Text\"), true);\n  }\n}\nfn start() { scored = []; reset_wave(); }\nfn update(dt) { if input_pressed(\"Restart\") { signal_emit(\"enemy.restart\", #{}); } }\nfn manager_restart(name, payload, source) {\n  timer_cancel(\"bounds\");\n  for target in query_group(\"knockout-target\", 16) { signal_emit_to(target.id, \"enemy.return\", #{}); }\n  remaining = 8; task_wait(\"restart_wave\", 0.05);\n}\nfn on_task(name) { if name == \"restart_wave\" { if query_group(\"knockout-target\", 16).len() > 0 { task_wait(\"restart_wave\", 0.05); return; } scored = []; reset_wave(); log_info(\"FAMILY_RESTART\"); } }\n",
