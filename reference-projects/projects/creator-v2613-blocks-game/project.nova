d\": \"parameters\",\n            \"index\": 0,\n            \"key\": \"parameters_0\",\n            \"start\": 10\n          },\n          {\n            \"childId\": \"07b4e261-0fa2-474a-a7cc-1fd7f0911ba7\",\n            \"end\": 1531,\n            \"fallback\": \"\",\n            \"field\": \"body\",\n            \"index\": -1,\n            \"key\": \"body\",\n            \"start\": 14\n          },\n          {\n            \"childId\": \"\",\n            \"end\": -1,\n            \"fallback\": \"\",\n            \"field\": \"parameters\",\n            \"index\": 1,\n            \"key\": \"parameters_1\",\n            \"start\": -1\n          }\n        ],\n        \"source\": \"fn update(dt) {\\n  if input_pressed(\\\"Restart\\\") { \\n  checkpoint = 0; elapsed = 0.0; finished = false; score_set(0.0); set_position(-7.5, -4.0);\\n  for index in 0..6 { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (index + 1)), index == 0); }\\n  ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint 1/6 | WASD / arrows | R restart\\\"); return; }\\n  if finished { return; }\\n  elapsed += dt;\\n  let pose = transform();\\n  let mx = input_axis(\\\"MoveHorizontal\\\"); let my = input_axis(\\\"MoveVertical\\\");\\n  if mx != 0.0 && my != 0.0 { mx *= 0.7071067811865476; my *= 0.7071067811865476; }\\n  let x = pose.position_x + mx * 6.0 * dt;\\n  let y = pose.position_y + my * 6.0 * dt;\\n  if x < -8.0 { x = -8.0; } else if x > 8.0 { x = 8.0; }\\n  if y < -4.5 { y = -4.5; } else if y > 4.5 { y = 4.5; }\\n  set_position(x, y);\\n  \\n  \\n  let xs = [-6.0, -3.0, 0.0, 3.0, 6.0, 0.0]; let ys = [-2.0, 1.0, 3.0, 1.0, -2.0, -3.0];\\n  let dx = x - xs[checkpoint]; let dy = y - ys[checkpoint];\\n  if dx * dx + dy * dy < 0.64 {\\n    entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), false);\\n    checkpoint += 1; score_add(1.0);\\n    if checkpoint == 6 { finished = true; ui_set_text_on(find_entity_handle(\\\"Scene Title