      "path": "Assets/Controllers/Blend2D.nova-controller",
      "assetType": "controller",
      "mimeType": "application/x-nova-controller",
      "byteLength": 1455,
      "source": "{\n  \"version\": 3,\n  \"name\": \"Blend 2D\",\n  \"defaultState\": \"move\",\n  \"parameters\": [\n    {\n      \"name\": \"MoveX\",\n      \"type\": \"Float\",\n      \"defaultValue\": 0\n    },\n    {\n      \"name\": \"MoveY\",\n      \"type\": \"Float\",\n      \"defaultValue\": 0\n    }\n  ],\n  \"states\": [\n    {\n      \"id\": \"move\",\n      \"name\": \"Move\",\n      \"clipAsset\": \"asset://1b5a3feb-7066-4f7c-804d-316e94c9e3fa\",\n      \"speed\": 1,\n      \"speedParameter\": null,\n      \"cycleOffset\": 0,\n      \"mirrorX\": false,\n      \"mirrorY\": false,\n      \"rootMotion\": \"Apply\",\n      \"x\": 80,\n      \"y\": 80,\n      \"subgraph\": \"Base\",\n      \"blendTree\": {\n        \"type\": \"2D\",\n        \"parameter\": \"MoveX\",\n        \"parameterY\": \"MoveY\",\n        \"synchronizeNormalizedTime\": true,\n        \"children\": [\n          {\n            \"clipAsset\": \"asset://1b5a3feb-7066-4f7c-804d-316e94c9e3fa\",\n            \"threshold\": 0,\n            \"positionX\": 0,\n            \"positionY\": 0,\n            \"speed\": 1\n          },\n          {\n            \"clipAsset\": \"asset://1b5a3feb-7066-4f7c-804d-316e94c9e3fa\",\n            \"threshold\": 1,\n            \"positionX\": 1,\n            \"positionY\": 1,\n            \"speed\": 1\n          }\n        ]\n      }\n    }\n  ],\n  \"transitions\": [],\n  \"layers\": [\n    {\n      \"id\": \"base\",\n      \"name\": \"Base\",\n      \"defaultState\": \"move\",\n      \"weight\": 1,\n      \"additive\": false,\n      \"maskAsset\": null,\n      \"synchronizedLayer\": null,\n      \"synchronizedTiming\": false\n    }\n  ]\n}",
