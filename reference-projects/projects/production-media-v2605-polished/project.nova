      "mimeType": "text/x-rhai",
      "byteLength": 276,
      "source": "@export(type=\"int\", min=0, max=999999, step=1, group=\"Game\", tooltip=\"Collected food\") let score = 0;\nfn start() { ui_set_text(\"Score  0\"); }\nfn on_signal(name, payload, source) {\n  if name != \"snake.scored\" { return; }\n  score = score + 1;\n  ui_set_text(`Score  ${score}`);\n}",
