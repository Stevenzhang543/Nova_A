    {
      "uuid": "871be09a-65f1-4cbc-8907-3d21a3b75ed0",
      "name": "BranchingSubtitle.nova-timeline",
      "path": "Assets/Timelines/BranchingSubtitle.nova-timeline",
      "assetType": "timeline",
      "mimeType": "application/x-nova-timeline",
      "byteLength": 1510,
      "source": "{\n  \"version\": 2,\n  \"name\": \"Branching Subtitle\",\n  \"duration\": 8,\n  \"frameRate\": 60,\n  \"markers\": [\n    {\n      \"id\": \"skip\",\n      \"name\": \"Skip\",\n      \"time\": 6,\n      \"color\": \"#6ea8ff\"\n    },\n    {\n      \"id\": \"resume\",\n      \"name\": \"Resume\",\n      \"time\": 2,\n      \"color\": \"#74d3ae\"\n    }\n  ],\n  \"skipMarker\": \"skip\",\n  \"resumeMarker\": \"resume\",\n  \"tracks\": [\n    {\n      \"id\": \"subtitle\",\n      \"name\": \"Subtitles\",\n      \"type\": \"Subtitle\",\n      \"muted\": false,\n      \"clips\": [\n        {\n          \"id\": \"caption\",\n          \"start\": 1,\n          \"duration\": 3,\n          \"offset\": 0,\n          \"playbackRate\": 1,\n          \"blendIn\": 0.2,\n          \"blendOut\": 0.2,\n          \"asset\": null,\n          \"targetEntityUuid\": null,\n          \"value\": \"A localized Title Safe subtitle.\",\n          \"payload\": \"\",\n          \"locale\": \"en\",\n          \"safeArea\": \"TitleSafe\",\n          \"skippable\": false\n        }\n      ]\n    },\n    {\n      \"id\": \"branch\",\n      \"name\": \"Branch\",\n      \"type\": \"Branch\",\n      \"muted\": false,\n      \"clips\": [\n        {\n          \"id\": \"choice\",\n          \"start\": 4,\n          \"duration\": 0.1,\n          \"offset\": 0,\n          \"playbackRate\": 1,\n          \"blendIn\": 0,\n          \"blendOut\": 0,\n          \"asset\": null,\n          \"targetEntityUuid\": null,\n          \"value\": \"skip\",\n          \"payload\": \"{\\\"variable\\\":\\\"route\\\",\\\"equals\\\":\\\"fast\\\"}\",\n          \"locale\": \"\",\n          \"safeArea\": \"TitleSafe\",\n          \"skippable\": true\n        }\n      ]\n    }\n  ]\n}",
