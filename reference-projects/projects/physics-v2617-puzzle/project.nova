        "cacheKey": "c67b45a87158b6b45c85dced1900ac3d9045f3eea24d131a21d8aefc16dd8982",
        "status": "ready",
        "lastValidSource": "\n@export(type=\"float\", min=0, max=1, step=0.01, group=\"Readout\") let readout_elapsed = 0.0;\nfn update(dt) {\n  readout_elapsed += dt;\n  if readout_elapsed < 0.1 { return; }\n  readout_elapsed = 0.0;\n  let pose = transform();\n  let x = (pose.position_x * 1000.0).round() / 1000.0;\n  let y = (pose.position_y * 1000.0).round() / 1000.0;\n  ui_set_text_on(find_entity_handle(\"Physics Readout\"), `X ${x} Y ${y}`);\n}\n",
