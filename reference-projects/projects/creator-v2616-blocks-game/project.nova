e_add(1.0);\\n    if checkpoint == 6 { finished = true; ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Course complete! | R to restart\\\"); }\\n    else { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), true); }\\n  }\\n  if !finished { ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint \\\" + (checkpoint + 1) + \\\"/6 | elapsed \\\" + elapsed.to_int() + \\\"s | R restart\\\"); }\\n}\",\n        \"sourceColumn\": 15,\n        \"sourceEnd\": 2064,\n        \"sourceStart\": 547,\n        \"syntaxScopeId\": \"scope:module/function:update/1:1\"\n      }\n    },\n    {\n      \"uuid\": \"a743321a-785a-42e3-a633-2f6565987b83\",\n      \"type\": \"rhai.Unary\",\n      \"title\": \"Unary\",\n      \"category\": \"Language values\",\n      \"position\": {\n        \"x\": 6074,\n        \"y\": 8480\n      },\n      \"size\": {\n        \"width\": 256,\n        \"height\": 110\n      },\n      \"collapsed\": false,\n      \"pins\": [\n        {\n          \"uuid\": \"284f4cbc-4705-4df7-a594-393b44e57363\",\n          \"key\": \"result\",\n          \"name\": \"Value\",\n          \"direction\": \"output\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"2f202cf0-a643-45da-aef2-beab07f48036\",\n          \"key\": \"operand\",\n          \"name\": \"operand\",\n          \"direction\": \"input\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": true,\n          \"defaultValue\": null\n        }\n      ],\n      \"config\": {\n        \"astId\": \"scope:module/function:update/1:1/node:Unary:efbc1280:1\",\n        \"bindingId\": \"\",\n        \"fieldSpans\": {\n          \"operator\": [\n            0,\n            1\n          ]\n        },\n        \"fields\": {\n          \"operator\": \"-\"\n        },\n        \"originalFields\