dy 3\",\n          \"direction\": \"input\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"f796749b-ec66-4db4-a373-304ff6eb8b8e\",\n          \"key\": \"body_4\",\n          \"name\": \"body 4\",\n          \"direction\": \"input\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"7dd3f613-a049-438e-adee-7dc7ee0cad38\",\n          \"key\": \"body_5\",\n          \"name\": \"Add body\",\n          \"direction\": \"input\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        }\n      ],\n      \"config\": {\n        \"astId\": \"program\",\n        \"bindingId\": \"\",\n        \"fieldSpans\": {},\n        \"fields\": {},\n        \"originalFields\": {},\n        \"ownedComments\": [],\n        \"slots\": [\n          {\n            \"childId\": \"3d9a3f87-70f8-4701-accc-08c730ff4060\",\n            \"end\": 70,\n            \"fallback\": \"\",\n            \"field\": \"body\",\n            \"index\": 0,\n            \"key\": \"body_0\",\n            \"start\": 0\n          },\n          {\n            \"childId\": \"c0698269-d171-46af-aecc-2f51103047df\",\n            \"end\": 146,\n            \"fallback\": \"\",\n            \"field\": \"body\",\n            \"index\": 1,\n            \"key\": \"body_1\",\n            \"start\": 71\n          },\n          {\n            \"childId\": \"59650c79-0f93-47cd-ac2c-d2515e353d0d\",\n            \"end\": 206,\n            \"fallback\": \"\",\n            \"field\": \"body\",\n            \"index\": 2,\n            \"key\": \"body_2\",\n            \"start\": 147\n          },\n          {\n            \"childId\": \"0e755ff7-fd11-4f21-a87f-5f06c73f6342\",\n            \"end\": 532,\n            \"fallback\": \"\",\n            \"field\": \"body\",\n            \"index\": 3,\n            \"key\": \"body_3\",\n            \"start\": 207\n          },\n          {\n            \"childId\": \"a664ecbd-abeb-48da-a15a-a27933c3dd21\",\n            \"end\": 2064,\n            \"fallback\": \"\",\n            \"field\": \"body\",\n            \"index\": 4,\n            \"key\": \"body_4\",\n            \"start\": 533\n          },\n          {\n            \"childId\": \"\",\n            \"end\": -1,\n            \"fallback\": \"\",\n            \"field\": \"body\",\n            \"index\": 5,\n            \"key\": \"body_5\",\n            \"start\": -1\n          }\n        ],\n        \"source\": \"@export(type=\\\"int\\\", min=0, max=8, group=\\\"Runtime\\\") let checkpoint = 0;\\n@export(type=\\\"float\\\", min=0, max=10000, group=\\\"Runtime\\\") let elapsed = 0.0;\\n@export(type=\\\"bool\\\", group=\\\"Runtime\\\") let finished = false;\\nfn start() { \\n  checkpoint = 0; elapsed = 0.0; finished = false; score_set(0.0); set_position(-7.5, -4.0);\\n  for index in 0..6 { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (index + 1)), index == 0); }\\n  ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint 1/6 | WASD / arrows | R restart\\\"); }\\nfn update(dt) {\\n  if input_pressed(\\\"Restart\\\") { \\n  checkpoint = 0; elapsed = 0.0; finished = false; score_set(0.0); set_position(-7.5, -4.0);\\n  for index in 0..6 { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (index + 1)), index == 0); }\\n  ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint 1/6 | WASD / arrows | R restart\\\"); return; }\\n  if finished { return; }\\n  elapsed += dt;\\n  let pose = transform();\\n  let mx = input_axis(\\\"MoveHorizontal\\\"); let my = input_axis(\\\"MoveVertical\\\");\\n  if mx != 0.0 && my != 0.0 { mx *= 0.7071067811865476; my *= 0.7071067811865476; }\\n  let x = pose.position_x + mx * 6.0 * dt;\\n  let y = pose.position_y + my * 6.0 * dt;\\n  if x < -8.0 { x = -8.0; } else if x > 8.0 { x = 8.0; }\\n  if y < -4.5 { y = -4.5; } else if y > 4.5 { y = 4.5; }\\n  set_position(x, y);\\n  \\n  \\n  let xs = [-6.0, -3.0, 0.0, 3.0, 6.0, 0.0]; let ys = [-2.0, 1.0, 3.0, 1.0, -2.0, -3.0];\\n  let dx = x - xs[checkpoint]; let dy = y - ys[checkpoint];\\n  if dx * dx + dy * dy < 0.64 {\\n    entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), false);\\n    checkpoint += 1; score_add(1.0);\\n    if checkpoint == 6 { finished = true; ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Course complete! | R to restart\\\"); }\\n    else { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), true); }\\n  }\\n  if !finished { ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint \\\" + (checkpoint + 1) + \\\"/6 | elapsed \\\" + elapsed.to_int() + \\\"s | R restart\\\"); }\\n}\",\n        \"sourceColumn\": 1,\n        \"sourceEnd\": 2064,\n        \"sourceStart\": 0,\n        \"syntaxScopeId\": \"scope:module\"\n      }\n    },\n    {\n      \"uuid\": \"4fd2886c-3d8b-4717-ae88-ce83f1a7bf03\",\n      \"type\": \"rhai.Identifier\",\n      \"title\": \"Identifier · dy\",\n      \"category\": \"Language values\",\n      \"position\": {\n        \"x\": 754,\n        \"y\": 11122\n      },\n      \"size\": {\n        \"width\": 256,\n        \"height\": 108\n      },\n      \"collapsed\": false,\n      \"pins\": [\n        {\n          \"uuid\": \"e28cbe09-0d2e-42f7-ac9c-40c467562fda\",\n          \"key\": \"result\",\n          \"name\": \"Value\",\n          \"direction\": \"output\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        }\n      ],\n      \"config\": {\n        \"astId\": \"scope:module/function:update/1:1/node:Identifier:dy:1\",\n        \"bindingId\": \"scop