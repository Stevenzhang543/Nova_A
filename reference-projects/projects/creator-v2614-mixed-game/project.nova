 restart\"); }\n    else { entity_set_enabled(find_entity_handle(\"Checkpoint \" + (checkpoint + 1)), true); }\n  }\n  if !finished { ui_set_text_on(find_entity_handle(\"Scene Title\"), \"Coin Trail | Checkpoint \" + (checkpoint + 1) + \"/6 | elapsed \" + elapsed.to_int() + \"s | R restart\"); }\n}",
