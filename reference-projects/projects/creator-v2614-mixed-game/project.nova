\\n  let xs = [-6.0, -3.0, 0.0, 3.0, 6.0, 0.0]; let ys = [-2.0, 1.0, 3.0, 1.0, -2.0, -3.0];\\n  let dx = x - xs[checkpoint]; let dy = y - ys[checkpoint];\\n  if dx * dx + dy * dy < 0.64 {\\n    entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), false);\\n    checkpoint += 1; score_add(1.0);\\n    if checkpoint == 6 { finished = true; ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Course complete! | R to restart\\\"); }\\n    else { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), true); }\\n  }\\n  if !finished { ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint \\\" + (checkpoint + 1) + \\\"/6 | elapsed \\\" + elapsed.to_int() + \\\"s | R restart\\\"); }\\n}\",\n    \"rootNodeUuid\": \"4f8cf58b-c363-470c-ac72-a03b4e5933b5\"\n  },\n  \"nodes\": [\n    {\n      \"uuid\": \"001ff15a-f552-427f-ad0f-fd11b92923dd\",\n      \"type\": \"rhai.Identifier\",\n      \"title\": \"Identifier · transform\",\n      \"category\": \"Language values\",\n      \"position\": {\n        \"x\": 5850,\n        \"y\": 4934\n      },\n      \"size\": {\n        \"width\": 256,\n        \"height\": 108\n      },\n      \"collapsed\": false,\n      \"pins\": [\n        {\n          \"uuid\": \"72426f65-6a45-4343-a949-68eebdbedbfe\",\n          \"key\": \"result\",\n          \"name\": \"Value\",\n          \"direction\": \"output\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        }\n      ],\n      \"config\": {\n        \"astId\": \"scope:module/function:update/1:1/node:Identifier:transform:1\",\n        \"bindingId\": \"\",\n        \"fieldSpans\": {\n          \"name\": [\n            0,\n            9\n          ]\n        },\n        \"fields\": {\n          \"name\": \"transform\"\n        },\n        \"originalFields\": {\n          \"name\": \"transform\"\n        },\n        \"ownedCommen