    {
      "uuid": "66000000-0000-4000-8000-000000000002",
      "name": "CoopClientPlayer.rhai",
      "path": "Assets/Scripts/CoopClientPlayer.rhai",
      "assetType": "script",
      "mimeType": "text/x-rhai",
      "byteLength": 469,
      "source": "fn fixed_update(dt) {\n  if !network_enabled() || !network_connected() || network_role() != \"client\" || network_tick() % 2 != 0 { return; }\n  network_rpc(\"coop.move\", #{ x: input_vector_x(\"Move\"), y: input_vector_y(\"Move\") });\n}\nfn on_signal(name, payload, source) {\n  let role = network_role();\n  if name != \"network.coop.move\" || (role != \"host\" && role != \"server\") { return; }\n  set_velocity(payload.payload.x.to_float() * 4.0, payload.payload.y.to_float() * 4.0);\n}",
      "sourceModified": 0,
      "importedAt": 0,
      "width": 0,
      "height": 0,
      "duration": 0,
      "fontFamily": "",
      "settings": {
        "filterMode": "Linear",
        "compression": "Lossless",
        "pixelsPerUnit": 100,
        "spriteRegion": null,
        "pivot": {
          "x": 0.5,
          "y": 0.5
        },
        "atlas": false
      },
      "pipeline": {
        "importerVersion": "reference-6.6",
        "platform": "web",
        "sourceHash": "8eaba6a41018f8d91277a33fc08652858a9f6e0c5987447e473335ea0d8bf867",
        "artifactHash": "8eaba6a41018f8d91277a33fc08652858a9f6e0c5987447e473335ea0d8bf867",
