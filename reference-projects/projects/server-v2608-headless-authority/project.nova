  "assets": [
    {
      "uuid": "66000000-0000-4000-8000-000000000001",
      "name": "CoopHostPlayer.rhai",
      "path": "Assets/Scripts/CoopHostPlayer.rhai",
      "assetType": "script",
      "mimeType": "text/x-rhai",
      "byteLength": 230,
      "source": "fn fixed_update(dt) {\n  if !network_enabled() || !network_connected() { return; }\n  let role = network_role();\n  if role == \"host\" || role == \"server\" { set_velocity(input_vector_x(\"Move\") * 4.0, input_vector_y(\"Move\") * 4.0); }\n}",
