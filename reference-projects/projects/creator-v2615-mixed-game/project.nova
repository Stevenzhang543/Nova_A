\\n  let xs = [-6.0, -3.0, 0.0, 3.0, 6.0, 0.0]; let ys = [-2.0, 1.0, 3.0, 1.0, -2.0, -3.0];\\n  let dx = x - xs[checkpoint]; let dy = y - ys[checkpoint];\\n  if dx * dx + dy * dy < 0.64 {\\n    entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), false);\\n    checkpoint += 1; score_add(1.0);\\n    if checkpoint == 6 { finished = true; ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Course complete! | R to restart\\\"); }\\n    else { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), true); }\\n  }\\n  if !finished { ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint \\\" + (checkpoint + 1) + \\\"/6 | elapsed \\\" + elapsed.to_int() + \\\"s | R restart\\\"); }\\n}\",\n    \"rootNodeUuid\": \"16ae90da-c140-4690-afbb-7cd8ef3a922a\"\n  },\n  \"nodes\": [\n    {\n      \"uuid\": \"010560d9-473f-4eb8-a46c-5e0aea754a29\",\n      \"type\": \"rhai.ExpressionStatement\",\n      \"title\": \"Expression Statement\",\n      \"category\": \"Language flow\",\n      \"position\": {\n        \"x\": 1282,\n        \"y\": 5622\n      },\n      \"size\": {\n        \"width\": 256,\n        \"height\": 110\n      },\n      \"collapsed\": false,\n      \"pins\": [\n        {\n          \"uuid\": \"f0d174d0-bbe3-4db2-a2de-e8bf679480a2\",\n          \"key\": \"result\",\n          \"name\": \"Value\",\n          \"direction\": \"output\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"0b638cf3-cc6f-4491-aefb-6d5596cc1dac\",\n          \"key\": \"expression\",\n          \"name\": \"expression\",\n          \"direction\": \"input\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": true,\n          \"defaultValue\": null\n        }\n      ],\n      \"config\": {\n        \"astId\": \"scope:module/function:update/1:1/bloc