    {
      "uuid": "46448320-ae63-47ac-8644-8320ae6397ac",
      "name": "TopDownController.rhai",
      "path": "Assets/Scripts/TopDownController.rhai",
      "assetType": "script",
      "mimeType": "text/x-rhai",
      "byteLength": 489,
      "source": "@export(type=\"float\", min=0, max=30, step=0.1, group=\"Movement\", tooltip=\"Top-down movement speed\") let speed = 7.0;\nfn update(dt) {\n  let move = input_vector(\"Move\");\n  set_velocity(move.x * speed, move.y * speed);\n  if input_pressed(\"Spawn\") { instantiate(\"asset://8ffe0f90-5a7f-4f24-8ffe-0f905a7fcf24\"); }\n}\nfn on_trigger_enter(other, px, py, nx, ny, rvx, rvy) {\n  save_set(\"last_trigger\", other);\n  save_set(\"checkpoint\", [px, py]);\n  save_commit(\"slot1\");\n  scene_load(\"Main Menu\");\n}",
      "sourceModified": 0,
      "importedAt": 0,
      "width": 0,
      "height": 0,
      "duration": 0,
      "fontFamily": "",
      "settings": {
        "filterMode": "Linear",
        "compression": "Lossless",
        "pixelsPerUnit": 100,
        "spriteRegion": null,
        "pivot": {
          "x": 0.5,
          "y": 0.5
        },
        "atlas": false
      },
      "pipeline": {
