    {
      "uuid": "1af55fb2-e152-43d6-8af5-5fb2e152a3d6",
      "name": "Getting Started.md",
      "path": "Assets/Tutorials/Getting Started.md",
      "assetType": "other",
      "mimeType": "text/markdown",
      "byteLength": 304,
      "source": "---\ndismissible: true\ntemplate: top-down\n---\n# Welcome to Nova_A Top-down Reference\n\nThis project was created from the **top-down** template. Open the Scene, Assets, Script, Debug, and Manage workspaces to explore the configured systems. Dismiss this tutorial from its Asset Inspector when you are ready.",
      "sourceModified": 0,
      "importedAt": 0,
      "width": 0,
      "height": 0,
      "duration": 0,
      "fontFamily": "",
      "settings": {
        "filterMode": "Linear",
        "compression": "Lossless",
        "pixelsPerUnit": 100,
        "spriteRegion": null,
        "pivot": {
          "x": 0.5,
          "y": 0.5
        },
        "atlas": false
      },
      "pipeline": {
        "importerVersion": "template-4.2",
        "platform": "web",
        "sourceHash": "b9cce869fbb3e625de40973458de58b32a6a8399b362c4dda581f3791ce3c00b",
