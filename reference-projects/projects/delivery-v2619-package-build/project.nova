rse complete! | R to restart\\\"); }\\n    else { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), true); }\\n  }\\n  if !finished { ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint \\\" + (checkpoint + 1) + \\\"/6 | elapsed \\\" + elapsed.to_int() + \\\"s | R restart\\\"); }\\n}\",\n        \"sourceColumn\": 15,\n        \"sourceEnd\": 2072,\n        \"sourceStart\": 547,\n        \"syntaxScopeId\": \"scope:module/function:update/1:1\"\n      }\n    },\n    {\n      \"uuid\": \"df569902-0199-4eb6-afc9-79073c1114a2\",\n      \"type\": \"rhai.Literal\",\n      \"title\": \"Literal\",\n      \"category\": \"Language values\",\n      \"position\": {\n        \"x\": 5322,\n        \"y\": 8658\n      },\n      \"size\": {\n        \"width\": 256,\n        \"height\": 108\n      },\n      \"collapsed\": false,\n      \"pins\": [\n        {\n          \"uuid\": \"18e4ec76-e7c3-4077-a68c-d504465eb85b\",\n          \"key\": \"result\",\n          \"name\": \"Value\",\n          \"direction\": \"output\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        }\n      ],\n      \"config\": {\n        \"astId\": \"scope:module/function:update/1:1/node:Literal:316cc23d:1\",\n        \"bindingId\": \"\",\n        \"fieldSpans\": {\n          \"raw\": [\n            0,\n            13\n          ]\n        },\n        \"fields\": {\n          \"literalKind\": \"string\",\n          \"raw\": \"\\\"Checkpoint \\\"\"\n        },\n        \"originalFields\": {\n          \"literalKind\": \"string\",\n          \"raw\": \"\\\"Checkpoint \\\"\"\n        },\n        \"ownedComments\": [],\n        \"slots\": [],\n        \"source\": \"\\\"Checkpoint \\\"\",\n        \"sourceColumn\": 35,\n        \"sourceEnd\": 1408,\n        \"sourceStart\": 1395,\n        \"syntaxScopeId\": \"scope:module/function:update/1:1\"\n      }\n    },\n    {\n