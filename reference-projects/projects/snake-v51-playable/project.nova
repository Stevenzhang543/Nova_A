    {
      "uuid": "f7703ed5-a415-4049-8770-3ed5a4155049",
      "name": "SnakeHead.rhai",
      "path": "Assets/Scripts/SnakeHead.rhai",
      "assetType": "script",
      "mimeType": "text/x-rhai",
      "byteLength": 1161,
      "source": "@export(type=\"float\", min=-1, max=1, step=1, group=\"Runtime\", tooltip=\"Current horizontal grid direction\") let direction_x = 1.0;\n@export(type=\"float\", min=-1, max=1, step=1, group=\"Runtime\", tooltip=\"Current vertical grid direction\") let direction_y = 0.0;\nfn start() { timer_start(\"snake-step\", 0.16, true); }\nfn update(dt) {\n  if input_pressed(\"MoveUp\") && direction_y != 1.0 { direction_x = 0.0; direction_y = -1.0; }\n  if input_pressed(\"MoveDown\") && direction_y != -1.0 { direction_x = 0.0; direction_y = 1.0; }\n  if input_pressed(\"MoveLeft\") && direction_x != 1.0 { direction_x = -1.0; direction_y = 0.0; }\n  if input_pressed(\"MoveRight\") && direction_x != -1.0 { direction_x = 1.0; direction_y = 0.0; }\n}\nfn on_timer(name) {\n  if name != \"snake-step\" { return; }\n  let pose = transform();\n  let next_x = pose.position_x + direction_x * 1.2;\n  let next_y = pose.position_y + direction_y * 1.2;\n  if next_x > 8.4 { next_x = -8.4; }\n  if next_x < -8.4 { next_x = 8.4; }\n  if next_y > 4.8 { next_y = -4.8; }\n  if next_y < -4.8 { next_y = 4.8; }\n  signal_emit(\"snake.segment.1\", #{ x: pose.position_x, y: pose.position_y });\n  set_position(next_x, next_y);\n}",
      "sourceModified": 0,
      "importedAt": 0,
      "width": 0,
      "height": 0,
      "duration": 0,
      "fontFamily": "",
      "settings": {
        "filterMode": "Linear",
        "compression": "Lossless",
        "pixelsPerUnit": 100,
        "spriteRegion": null,
        "pivot": {
          "x": 0.5,
          "y": 0.5
        },
        "atlas": false
      },
      "pipeline": {
        "importerVersion": "template-4.2",
        "platform": "web",
        "sourceHash": "81cfce5022cf97a3143282849518365ba693f5b5b5c74fb9a2fedf65e8e64da0",
        "artifactHash": "81cfce5022cf97a3143282849518365ba693f5b5b5c74fb9a2fedf65e8e64da0",
        "contentHash": "81cfce5022cf97a3143282849518365ba693f5b5b5c74fb9a2fedf65e8e64da0",
        "cacheKey": "81cfce5022cf97a3143282849518365ba693f5b5b5c74fb9a2fedf65e8e64da0",
        "status": "ready",
        "lastValidSource": "@export(type=\"float\", min=-1, max=1, step=1, group=\"Runtime\", tooltip=\"Current horizontal grid direction\") let direction_x = 1.0;\n@export(type=\"float\", min=-1, max=1, step=1, group=\"Runtime\", tooltip=\"Current vertical grid direction\") let direction_y = 0.0;\nfn start() { timer_start(\"snake-step\", 0.16, true); }\nfn update(dt) {\n  if input_pressed(\"MoveUp\") && direction_y != 1.0 { direction_x = 0.0; direction_y = -1.0; }\n  if input_pressed(\"MoveDown\") && direction_y != -1.0 { direction_x = 0.0; direction_y = 1.0; }\n  if input_pressed(\"MoveLeft\") && direction_x != 1.0 { direction_x = -1.0; direction_y = 0.0; }\n  if input_pressed(\"MoveRight\") && direction_x != -1.0 { direction_x = 1.0; direction_y = 0.0; }\n}\nfn on_timer(name) {\n  if name != \"snake-step\" { return; }\n  let pose = transform();\n  let next_x = pose.position_x + direction_x * 1.2;\n  let next_y = pose.position_y + direction_y * 1.2;\n  if next_x > 8.4 { next_x = -8.4; }\n  if next_x < -8.4 { next_x = 8.4; }\n  if next_y > 4.8 { next_y = -4.8; }\n  if next_y < -4.8 { next_y = 4.8; }\n  signal_emit(\"snake.segment.1\", #{ x: pose.position_x, y: pose.position_y });\n  set_position(next_x, next_y);\n}",
