    {
      "uuid": "a8330423-64e7-4967-8833-042364e79967",
      "name": "SnakeFood.rhai",
      "path": "Assets/Scripts/SnakeFood.rhai",
      "assetType": "script",
      "mimeType": "text/x-rhai",
      "byteLength": 208,
      "source": "fn on_trigger_enter(other, px, py, nx, ny, rvx, rvy) {\n  if other != find_entity(\"Snake Head\") { return; }\n  signal_emit(\"snake.scored\", 1);\n  set_position(random_range(-7.2, 7.2), random_range(-4.2, 4.2));\n}",
