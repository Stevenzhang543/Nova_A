  "assets": [
    {
      "uuid": "66000000-0000-4000-8000-000000000001",
      "name": "CoopHostPlayer.rhai",
      "path": "Assets/Scripts/CoopHostPlayer.rhai",
      "assetType": "script",
      "mimeType": "text/x-rhai",
      "byteLength": 867,
      "source": "// 双人本地会话参考：固定步处理输入或 RPC，显示实际复制坐标。\n// 固定物理步根据本端角色执行移动或发送输入。\nfn fixed_update(dt) {\n  if !network_enabled() || !network_connected() { return; }\n  let role = network_role();\n  if role == \"host\" || role == \"server\" { set_velocity(input_vector_x(\"Move\") * 4.0, input_vector_y(\"Move\") * 4.0); }\n}\n@export(type=\"float\", min=0, max=1, step=0.01, group=\"Readout\") let readout_elapsed = 0.0;\n// 每十分之一秒把实体真实位置显示到对应 HUD。\nfn update(dt) {\n  readout_elapsed += dt;\n  if readout_elapsed < 0.1 { return; }\n  readout_elapsed = 0.0;\n  let pose = transform();\n  let x = (pose.position_x * 1000.0).round() / 1000.0;\n  let y = (pose.position_y * 1000.0).round() / 1000.0;\n  ui_set_text_on(find_entity_handle(\"Host Readout\"), \"Host X \" + x + \" Y \" + y);\n}\n",
      "sourceModified": 0,
      "importedAt": 0,
      "width": 0,
      "height": 0,
      "duration": 0,
      "fontFamily": "",
      "settings": {
        "filterMode": "Linear",
        "compression": "Lossless",
        "pixelsPerUnit": 100,
        "spriteRegion": null,
        "pivot": {
          "x": 0.5,
          "y": 0.5
        },
        "atlas": false
      },
      "pipeline": {
        "importerVersion": "reference-6.6",
        "platform": "web",
        "sourceHash": "15196fe2b41fe8141640d3e1a36ede0d2ae0f5259af355b682f3db6b2fdf49f2",
        "artifactHash": "15196fe2b41fe8141640d3e1a36ede0d2ae0f5259af355b682f3db6b2fdf49f2",
        "contentHash": "15196fe2b41fe8141640d3e1a36ede0d2ae0f5259af355b682f3db6b2fdf49f2",
        "cacheKey": "15196fe2b41fe8141640d3e1a36ede0d2ae0f5259af355b682f3db6b2fdf49f2",
        "status": "ready",
        "lastValidSource": "// 双人本地会话参考：固定步处理输入或 RPC，显示实际复制坐标。\n// 固定物理步根据本端角色执行移动或发送输入。\nfn fixed_update(dt) {\n  if !network_enabled() || !network_connected() { return; }\n  let role = network_role();\n  if role == \"host\" || role == \"server\" { set_velocity(input_vector_x(\"Move\") * 4.0, input_vector_y(\"Move\") * 4.0); }\n}\n@export(type=\"float\", min=0, max=1, step=0.01, group=\"Readout\") let readout_elapsed = 0.0;\n// 每十分之一秒把实体真实位置显示到对应 HUD。\nfn update(dt) {\n  readout_elapsed += dt;\n  if readout_elapsed < 0.1 { return; }\n  readout_elapsed = 0.0;\n  let pose = transform();\n  let x = (pose.position_x * 1000.0).round() / 1000.0;\n  let y = (pose.position_y * 1000.0).round() / 1000.0;\n  ui_set_text_on(find_entity_handle(\"Host Readout\"), \"Host X \" + x + \" Y \" + y);\n}\n",
        "error": "",
