    {
      "uuid": "29290000-0000-4000-8000-000000000030",
      "name": "StreamReadout.rhai",
      "path": "Assets/Scripts/StreamReadout.rhai",
      "assetType": "script",
      "mimeType": "text/x-rhai",
      "byteLength": 259,
      "source": "// 流送场景激活后显示真实会话身份和远端数量，便于诊断导出双端连接。\nfn update(dt) {\n  ui_set_text_on(find_entity_handle(\"Stream Readout\"), \"Streamed landmark active | \" + network_role() + \" | peers \" + network_peer_count());\n}\n",
