        "lastValidSource": "// @nova-graph-link bbda36db-0673-4e7b-afa1-156a42ada0dd\n// Rhai structure IR 1: code and typed nodes share the same program.\n@export(type=\"int\", min=0, max=8, group=\"Runtime\") let checkpoint = 0;\n@export(type=\"float\", min=0, max=10000, group=\"Runtime\") let elapsed = 0.0;\n@export(type=\"bool\", group=\"Runtime\") let finished = false;\nfn start() { \n  checkpoint = 0; elapsed = 0.0; finished = false; score_set(0.0); set_position(-7.5, -4.0);\n  for index in 0..6 { entity_set_enabled(find_entity_handle(\"Checkpoint \" + (index + 1)), index == 0); }\n  ui_set_text_on(find_entity_handle(\"Scene Title\"), \"Coin Trail | Checkpoint 1/6 | WASD / arrows | R restart\"); }\nfn update(dt) {\n  if input_pressed(\"Restart\") { \n  checkpoint = 0; elapsed = 0.0; finished = false; score_set(0.0); set_position(-7.5, -4.0);\n  for index in 0..6 { entity_set_enabled(find_entity_handle(\"Checkpoint \" + (index + 1)), index == 0); }\n  ui_set_text_on(find_entity_handle(\"Scene Title\"), \"Coin Trail | Checkpoint 1/6 | WASD / arrows | R restart\"); return; }\n  if finished { return; }\n  elapsed += dt;\n  let pose = transform();\n  let mx = input_axis(\"MoveHorizontal\"); let my = input_axis(\"MoveVertical\");\n  if mx != 0.0 && my != 0.0 { mx *= 0.7071067811865476; my *= 0.7071067811865476; }\n  let x = pose.position_x + mx * 6.0 * dt;\n  let y = pose.position_y + my * 6.0 * dt;\n  if x < -8.0 { x = -8.0; } else if x > 8.0 { x = 8.0; }\n  if y < -4.5 { y = -4.5; } else if y > 4.5 { y = 4.5; }\n  set_position(x, y);\n  \n  \n  let target = find_entity_handle(\"Checkpoint \" + (checkpoint + 1));\n  let dx = x - entity_position_x_on(target); let dy = y - entity_position_y_on(target);\n  if dx * dx + dy * dy < 0.64 {\n    entity_set_enabled(find_entity_handle(\"Checkpoint \" + (checkpoint + 1)), false);\n    checkpoint += 1; score_add(1.0);\n    if checkpoint == 6 { finished = true; ui_set_text_on(find_entity_handle(\"Scene Title\"), \"Course complete! | R to restart\"); }\n    else { entity_set_enabled(find_entity_handle(\"Checkpoint \" + (checkpoint + 1)), true); }\n  }\n  if !finished { ui_set_text_on(find_entity_handle(\"Scene Title\"), \"Coin Trail | Checkpoint \" + (checkpoint + 1) + \"/6 | elapsed \" + elapsed.to_int() + \"s | R restart\"); }\n}",
