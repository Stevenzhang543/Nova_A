: \"@export(type=\\\"int\\\", min=0, max=8, group=\\\"Runtime\\\") let checkpoint = 0;\\n@export(type=\\\"float\\\", min=0, max=10000, group=\\\"Runtime\\\") let elapsed = 0.0;\\n@export(type=\\\"bool\\\", group=\\\"Runtime\\\") let finished = false;\\nfn start() { \\n  checkpoint = 0; elapsed = 0.0; finished = false; score_set(0.0); set_position(-7.5, -4.0);\\n  for index in 0..6 { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (index + 1)), index == 0); }\\n  ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint 1/6 | WASD / arrows | R restart\\\"); }\\nfn update(dt) {\\n  if input_pressed(\\\"Restart\\\") { \\n  checkpoint = 0; elapsed = 0.0; finished = false; score_set(0.0); set_position(-7.5, -4.0);\\n  for index in 0..6 { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (index + 1)), index == 0); }\\n  ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint 1/6 | WASD / arrows | R restart\\\"); return; }\\n  if finished { return; }\\n  elapsed += dt;\\n  let pose = transform();\\n  let mx = input_axis(\\\"MoveHorizontal\\\"); let my = input_axis(\\\"MoveVertical\\\");\\n  if mx != 0.0 && my != 0.0 { mx *= 0.7071067811865476; my *= 0.7071067811865476; }\\n  let x = pose.position_x + mx * 6.0 * dt;\\n  let y = pose.position_y + my * 6.0 * dt;\\n  if x < -8.0 { x = -8.0; } else if x > 8.0 { x = 8.0; }\\n  if y < -4.5 { y = -4.5; } else if y > 4.5 { y = 4.5; }\\n  set_position(x, y);\\n  \\n  \\n  let target = find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1));\\n  let dx = x - entity_position_x_on(target); let dy = y - entity_position_y_on(target);\\n  if dx * dx + dy * dy < 0.64 {\\n    entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), false);\\n    checkpoint += 1; score_add(1.0);\\n    if checkpoint == 6 { finished = true; ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Course complete! | R to restart\\\"); }\\n    else { entity_set_enabled(find_entity_handle(\\\"Checkpoint \\\" + (checkpoint + 1)), true); }\\n  }\\n  if !finished { ui_set_text_on(find_entity_handle(\\\"Scene Title\\\"), \\\"Coin Trail | Checkpoint \\\" + (checkpoint + 1) + \\\"/6 | elapsed \\\" + elapsed.to_int() + \\\"s | R restart\\\"); }\\n}\",\n        \"sourceColumn\": 1,\n        \"sourceEnd\": 2072,\n        \"sourceStart\": 0,\n        \"syntaxScopeId\": \"scope:module\"\n      }\n    },\n    {\n      \"uuid\": \"0435377e-934d-46e1-a336-f9cd8998c4b8\",\n      \"type\": \"rhai.Assignment\",\n      \"title\": \"Assignment\",\n      \"category\": \"Language values\",\n      \"position\": {\n        \"x\": 2202,\n        \"y\": 8486\n      },\n      \"size\": {\n        \"width\": 256,\n        \"height\": 138\n      },\n      \"collapsed\": false,\n      \"pins\": [\n        {\n          \"uuid\": \"2f236227-9355-41d5-a099-7c26687379d1\",\n          \"key\": \"result\",\n          \"name\": \"Value\",\n          \"direction\": \"output\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": false,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"fc36af6c-e415-4cf0-a229-520147217b9b\",\n          \"key\": \"target\",\n          \"name\": \"target\",\n          \"direction\": \"input\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": true,\n          \"defaultValue\": null\n        },\n        {\n          \"uuid\": \"fc932288-4fac-435e-a2c3-ce17c2f81012\",\n          \"key\": \"value\",\n          \"name\": \"value\",\n          \"direction\": \"input\",\n          \"kind\": \"data\",\n          \"valueType\": \"Data\",\n          \"required\": true,\n          \"defaultValue\": null\n        }\n      ],\n      \"config\": {\n        \"astId\": \"scope:module/function:update/1:1/block:4/node:Assignment:b26aef43:1\",\n        \"bindingId\": \"\",\n        \"fieldSpans\": {\n          \"operator\": [\n         